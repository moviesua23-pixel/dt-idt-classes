{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAStudyBoardAnimationLibrary",
  "type": "object",
  "required": [
    "version",
    "animations"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "neutral_generic_words": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ui_label_whitelist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "selection",
          "slots",
          "derived",
          "duration",
          "scene",
          "cues"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string"
          },
          "selection": {
            "type": "object",
            "required": [
              "when_to_use",
              "not_for",
              "situation_types",
              "asset_types",
              "topics",
              "required_slots"
            ],
            "properties": {
              "when_to_use": {
                "type": "string"
              },
              "not_for": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "situation_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "asset_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_slots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "slots": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "type",
                "default"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "number",
                    "date",
                    "percent",
                    "boolean",
                    "enum",
                    "list"
                  ]
                },
                "default": {},
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "max_len": {
                  "type": "number"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "inr",
                    "plain",
                    "percent",
                    "date"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "derived": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "expr"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "expr": {
                  "type": "string"
                }
              }
            }
          },
          "duration": {
            "type": "number",
            "minimum": 6.0,
            "maximum": 30.0
          },
          "cues": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "default_t"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "default_t": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            }
          },
          "scene": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                },
                "props": {
                  "type": "object"
                },
                "bind": {
                  "type": "object"
                },
                "cue": {
                  "type": "string"
                },
                "offset_t": {
                  "type": "number"
                },
                "enter": {
                  "type": "string"
                },
                "enter_dur": {
                  "type": "number"
                },
                "motion": {
                  "type": "object"
                },
                "when": {
                  "type": "string"
                },
                "is_container": {
                  "type": "boolean"
                },
                "badge_on": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}