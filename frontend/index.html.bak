          </div>
          <div class="flow-title" style="font-size:1.05rem">Default Tax Regime</div>
          <div class="flow-desc" style="font-size:.85rem">Applies automatically unless assessee formally opts out u/s 115BAC(6). Add 4% Cess.</div>
        </div>
      </div>
    </div>`;
  }

  if(qn === 7){
    return `
    <div class="flow-grid" style="grid-template-columns:1fr 1fr;gap:18px">
      <div class="flow-node" data-t0="0" data-t1="9.0" id="fn-q7-1">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span class="flow-badge blue">Step 1 · Eligibility</span>
          <span class="flow-active-badge">● EXPLAINING NOW</span>
        </div>
        <div class="flow-title">Total Income ≤ ₹ 12 Lakhs</div>
        <div class="flow-desc">Resident individuals earning total income up to ₹ 12,00,000 under the default regime qualify for enhanced rebate.</div>
        <div style="margin-top:10px;padding:8px 12px;background:rgba(58,134,255,0.2);border-radius:8px;font-weight:700;color:#60A5FA;text-align:center">Threshold Limit: ₹ 12,00,000</div>
      </div>

      <div class="flow-node" data-t0="9.0" data-t1="17.0" id="fn-q7-2">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span class="flow-badge gold">Step 2 · Enhanced Rebate</span>
          <span class="flow-active-badge">● EXPLAINING NOW</span>
        </div>
        <div class="flow-title">Max Rebate: ₹ 60,000</div>
        <div class="flow-desc">Tax on ₹ 12,00,000 is ₹ 60,000 (₹ 20k @ 5% + ₹ 40k @ 10%). The entire tax is rebated u/s 87A!</div>
        <div style="margin-top:10px;padding:8px 12px;background:rgba(245,158,11,0.2);border-radius:8px;font-weight:700;color:#FBBF24;text-align:center">Full Tax Absorbed: (-) ₹ 60,000</div>
      </div>
    </div>

    <div class="flow-node" data-t0="17.0" data-t1="25.0" id="fn-q7-3" style="margin-top:16px;border-left:4px solid #10B981">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span class="flow-badge green">Step 3 · Net Result</span>
        <span class="flow-active-badge">● EXPLAINING NOW</span>
      </div>
      <div style="font-size:1.15rem;font-weight:800;color:#34D399;margin-bottom:6px">
        Net Tax Payable = ₹ 0 (NIL TAX)
      </div>
      <div class="flow-desc">Under Section 115BAC, any resident individual earning up to ₹ 12,00,000 has <b>ZERO tax liability</b>. Tax begins only once Total Income crosses ₹ 12 Lakhs!</div>
    </div>`;
  }

  if(qn === 8){
    return `
    <div class="flow-grid" style="grid-template-columns:1fr 1fr;gap:18px">
      <div class="flow-node" data-t0="0" data-t1="11.0" id="fn-q8-1">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span class="flow-badge red">The Problem</span>
          <span class="flow-active-badge">● EXPLAINING NOW</span>
        </div>
        <div class="flow-title">Marginal Excess Above ₹ 12 Lakhs</div>
        <div class="flow-desc">If income increases to ₹ 12,10,000, losing the entire ₹ 60,000 rebate would make tax ₹ 61,500 — paying ₹ 61,500 extra tax for just ₹ 10,000 extra income!</div>
      </div>

      <div class="flow-node" data-t0="11.0" data-t1="20.0" id="fn-q8-2" style="border-left:4px solid #F59E0B">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span class="flow-badge gold">The Statutory Remedy</span>
          <span class="flow-active-badge">● EXPLAINING NOW</span>
        </div>
        <div class="flow-title">Incremental Tax Capped at Excess Income</div>
        <div class="flow-desc"><b>Formula:</b> Rebate u/s 87A = Tax on Total Income - (Total Income - ₹ 12,00,000).<br>Tax cannot exceed excess income over ₹ 12L!</div>
      </div>
    </div>

    <div class="flow-node" data-t0="20.0" data-t1="28.0" id="fn-q8-3" style="margin-top:16px;border-left:4px solid #10B981">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span class="flow-badge green">Worked Numerical Example</span>
        <span class="flow-active-badge">● EXPLAINING NOW</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:8px">
        <div style="padding:10px;background:rgba(0,0,0,0.25);border-radius:8px"><span>1. Slab Tax on ₹ 12.1L:</span><br><b style="color:#F8FAFC">₹ 61,500</b></div>
        <div style="padding:10px;background:rgba(0,0,0,0.25);border-radius:8px"><span>2. Marginal Relief:</span><br><b style="color:#FBBF24">₹ 51,500</b></div>
        <div style="padding:10px;background:rgba(16,185,129,0.2);border-radius:8px"><span>3. Net Tax + Cess:</span><br><b style="color:#34D399">₹ 10,400 (Capped!)</b></div>
      </div>
    </div>`;
  }

  return `
  <div class="flow-node flow-active" data-t0="0" data-t1="999">
    <div class="flow-title">${esc(p.doctrine)}</div>
    <div class="flow-desc">${esc(p.principle || "Statutory Rule Flowchart")}</div>
  </div>`;
}

function vStudio(r){
 const list=qs(r.sub,r.ch),i=list.findIndex(q=>q.n===r.n),q=list[i];
 if(!q){go(`${r.sub}-c${r.ch}`);return}
 const p=D.prov[q.topic]||{doctrine:q.title,principle:"",secs:q.secs||[],dur:60,file:`q${q.n}.mp3`,ml:""};
 const prev=list[i-1],next=list[i+1],base=`${r.sub}-c${r.ch}`;
 mount(`<div class="studio-nav rise"><button class="nav-btn" data-go="${base}">${I.back}Questions</button>
   <div class="stepper"><button class="nav-btn" ${prev?`data-go="${base}-q${prev.n}"`:"disabled"} aria-label="Previous question">${I.back}Prev</button><span class="count">Q${i+1} of ${list.length}</span>
   <button class="nav-btn" ${next?`data-go="${base}-q${next.n}"`:"disabled"} aria-label="Next question">Next${I.arrow.replace('width="22" height="22"','width="18" height="18"')}</button></div></div>
  <div class="studio"><nav class="rail rise" style="--i:2" id="rail" aria-label="Study stages">${["Provision & rules","Malayalam audio","Exam question","ICAI solution"].map((t,k)=>`<a href="#s${k+1}" data-st="${k+1}" class="${k===0?"on":""}"><b>${k+1}</b>${t}</a>`).join("")}</nav>
  <div class="stack">
   <section class="stage rise" style="--i:2" id="st1" data-s="1">${stageHead(1,"Statutory Provision & Rules Matrix")}
    <div class="prov-banner">
      <div class="prov-banner-meta">
        <span class="prov-tag">§ Statutory Doctrine</span>
        <div class="prov-secs">${(p.secs||[]).map(x=>`<span class="sec">${esc(x)}</span>`).join("")}</div>
      </div>
      <h3 class="prov-title">${esc(p.doctrine)}</h3>
    </div>
    <div class="md-content">
      ${p.rawMarkdown ? renderProvMarkdown(p.rawMarkdown, p.doctrine) : tbl(p.table)}
    </div>
   </section>
   <section class="stage rise" style="--i:3" id="st2" data-s="2">${stageHead(2,"Spoken Malayalam Explainer")}
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:-8px 0 16px">
      <p class="note" style="margin:0">Covers the statutory doctrine in clear spoken Malayalam with synchronized visual flowchart.</p>
      <div style="display:flex;align-items:center;gap:8px">
        <button id="vtog" class="pill" style="border:1px solid var(--accent);background:var(--accent-soft);color:var(--accent);cursor:pointer;font-weight:600" aria-label="Toggle flowchart theater">
          <span>📺 Flowchart Theater</span>
        </button>
        <span class="pill ok"><i class="dot"></i>${esc(p.voice || "Gemini Voice (Aoede)")}</span>
      </div>
    </div>

    <!-- PowerPoint Presentation Explainer Theater -->
    <div class="vtheater" id="vtheater" style="display:none">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 24px;background:#FFFFFF;border-bottom:1px solid #E2E8F0;flex-wrap:wrap;gap:12px;position:sticky;top:0;z-index:30">
        <div style="display:flex;align-items:center;gap:12px">
          <span style="font-family:var(--f-mono);font-size:.76rem;background:#EFF6FF;color:#2563EB;border:1px solid #BFDBFE;padding:4px 10px;border-radius:6px;font-weight:700">§ STATUTORY PRESENTATION</span>
          <span style="font-size:1.02rem;font-weight:700;color:#0F172A">${esc(p.doctrine)}</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <button id="vtab-diag" class="pill" style="border:1px solid var(--accent);background:var(--accent);color:#fff;cursor:pointer;font-weight:700;font-size:.82rem;padding:6px 16px;border-radius:20px">✨ Interactive Presentation</button>
          <button id="vtab-vid" class="pill" style="border:1px solid #CBD5E1;background:#F8FAFC;color:#475569;cursor:pointer;font-weight:600;font-size:.82rem;padding:6px 16px;border-radius:20px">🎬 1080p Video</button>
          <button id="vfs" style="color:#475569;padding:6px 14px;border-radius:8px;font-size:.84rem;font-weight:600;background:#F1F5F9;border:1px solid #CBD5E1;cursor:pointer" title="Toggle Fullscreen">⛶ Fullscreen</button>
          <button id="vclose" style="color:#EF4444;padding:6px 14px;border-radius:8px;font-size:.84rem;font-weight:700;background:#FEF2F2;border:1px solid #FECACA;cursor:pointer" aria-label="Close presentation">✕ Close</button>
        </div>
      </div>

      <!-- View 1: Interactive Animated Presentation Slide (Only Explaining Slide) -->
      <div id="vdiag" class="vfullscreen-stage">
        ${renderFlowchartHtml(q, p)}
      </div>

      <!-- View 2: Video Player -->
      <div id="vvidwrap" style="display:none;background:#000;flex:1;place-items:center;align-items:center;justify-content:center">
        <video id="fvideo" playsinline preload="auto" style="width:100%;max-height:calc(100vh - 160px);aspect-ratio:16/9;background:#000;object-fit:contain" src="/video/${esc(p.video || (p.file ? p.file.replace('.mp3', '.mp4') : 'q1.mp4'))}"></video>
      </div>

      <!-- Fullscreen Bottom Synchronized Control Bar -->
      <div class="vtheater-dock" id="vtheater-dock">
        <button class="vtd-play" id="vtd-play" aria-label="Play/Pause">${I.play}</button>
        <div style="display:flex;flex-direction:column;min-width:110px">
          <span id="vtd-time" style="font-family:var(--f-mono);font-size:.82rem;font-weight:600;color:#0F172A">0:00 / ${fmt(p.dur)}</span>
          <span id="vtd-label" style="font-size:.74rem;color:#64748B;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Slide 1 of 4</span>
        </div>
        <input type="range" class="vtd-seek" id="vtd-seek" min="0" max="1000" value="0" aria-label="Seek presentation">
        <button id="vtd-speed" class="pill idle" style="font-family:var(--f-mono);font-weight:600">1.0x</button>
        <button id="vtd-close" class="pill" style="border:1px solid #FECACA;background:#FEF2F2;color:#EF4444;font-weight:700;cursor:pointer">✕ Close</button>
      </div>
    </div>

    <div class="player" id="player"><div class="wave" id="wave">${Array.from({length:56},(_,k)=>`<i style="--k:${k};--h:${22+Math.round(70*Math.abs(Math.sin(k*.9+p.dur)*Math.cos(k*.31)))}%"></i>`).join("")}</div>
     <div class="ctrl"><span class="playwrap"><svg class="pring" viewBox="0 0 64 64" aria-hidden="true"><circle class="bg" cx="32" cy="32" r="28"/><circle class="fg" id="ringc" cx="32" cy="32" r="28"/></svg><button class="play" id="play" aria-label="Play audio">${I.play}</button></span><span class="time" id="time">0:00 / ${fmt(p.dur)}</span>
      <input type="range" id="seek" min="0" max="1000" value="0" aria-label="Seek audio"><button class="speed" id="speed" aria-label="Playback speed">1.0x</button></div>
     <p class="note" id="anote"></p></div>
    <button class="drawer-btn" id="sbtn" aria-expanded="false" aria-controls="sdr">Malayalam script ${I.down}</button>
    <div class="drawer" id="sdr"><div><div class="script" lang="ml">${esc(p.ml)}</div></div></div></section>
   <section class="stage rise" style="--i:4" id="st3" data-s="3">${stageHead(3,"The Exam Question")}<div class="qtext">${(q.q||[]).map(x=>`<p>${esc(x)}</p>`).join("")}</div></section>
   <section class="stage rise" style="--i:5" id="st4" data-s="4">${stageHead(4,"ICAI Suggested Solution")}
    <button class="sol-toggle" id="soltog" aria-expanded="false" aria-controls="soldr"><span>Show the suggested solution</span>${I.down}</button>
    <div class="drawer" id="soldr"><div><div class="sol">
      ${q.rawAnswer ? `<div class="md-content">${renderAnswerMarkdown(q.rawAnswer)}</div>` : (q.a?.p||[]).map(x=>`<p>${esc(x)}</p>`).join("") + tbl(q.a?.t) + (q.a?.c ? `<div class="concl"><b>Conclusion.</b> ${esc(q.a.c)}</div>` : "")}
    </div></div></div></section>
  </div></div>`,r);
 bindStudio(q,p,r)}

function bindStudio(q,p,r){
 const toggle=(btn,dr,a,b)=>{const o=btn.getAttribute("aria-expanded")!=="true";btn.setAttribute("aria-expanded",o);dr.classList.toggle("open",o);if(b)b(o)};
 $("#sbtn").onclick=()=>toggle($("#sbtn"),$("#sdr"));
 const st=$("#soltog"),sd=$("#soldr");
 st.onclick=()=>{
  toggle(st, sd, null, (o)=>{
   if (o) requestAnimationFrame(() => renderMath(sd));
  });
 };
 /* stage rail */
 const links=$$("#rail a");
 links.forEach(a=>a.onclick=e=>{e.preventDefault();$("#st"+a.dataset.st).scrollIntoView({behavior:REDUCED?"auto":"smooth",block:"start"})});
 io=new IntersectionObserver(es=>es.forEach(en=>{if(!en.isIntersecting)return;const k=+en.target.dataset.s;
  links.forEach((a,j)=>{a.classList.toggle("on",j+1===k);a.classList.toggle("done",j+1<k)})}),{rootMargin:"-30% 0px -60% 0px"});
 $$(".stage").forEach(s=>io.observe(s));

 const st1 = $("#st1");
 if(st1){
  renderMath(st1);
 }

 player=makePlayer(p)}

/* ---------- audio player ---------- */
function makePlayer(p){
 const root=$("#player"),playB=$("#play"),seek=$("#seek"),time=$("#time"),spd=$("#speed"),note=$("#anote"),bars=$$("#wave i");
 const vtheater=$("#vtheater"),fvideo=$("#fvideo"),vtog=$("#vtog"),vclose=$("#vclose");
 if(fvideo) fvideo.muted = true;
 const speeds=[1,1.25,1.5,2];let si=0,playing=false,vraf=0,dead=false;
 const audioFile = p.file || "q1.mp3";
 const audioBase = audioFile.startsWith('/') ? audioFile : "/audio/" + audioFile;
 const audioUrl = audioBase + "?v=aoede_" + Math.round(p.dur || 1);
 
 const audio = new Audio();
 audio.preload = "auto";
 audio.src = audioUrl;

 const total = () => (audio && isFinite(audio.duration) && audio.duration > 0) ? audio.duration : (p.dur || 75);

 function ui(){
  const cur = audio.currentTime || 0;
  const T = total();
  const f = T > 0 ? Math.min(1, Math.max(0, cur / T)) : 0;
  time.textContent = fmt(cur) + " / " + fmt(T);
  seek.value = Math.round(f * 1000);
  seek.style.setProperty("--p", f);
  const n = Math.round(f * bars.length);
  bars.forEach((b, k) => b.classList.toggle("on", k < n));
  const rc = $("#ringc");
  if(rc) rc.style.strokeDashoffset = 175.9 * (1 - f);
  if(fvideo && !fvideo.paused && Math.abs(fvideo.currentTime - cur) > 0.35){
   fvideo.currentTime = cur;
  }
  const vtdTime = $("#vtd-time");
  if(vtdTime) vtdTime.textContent = fmt(cur) + " / " + fmt(T);
  const vtdSeek = $("#vtd-seek");
  if(vtdSeek) vtdSeek.value = Math.round(f * 1000);
  const vtdPlay = $("#vtd-play");
  if(vtdPlay) vtdPlay.innerHTML = playing ? I.pause : I.play;
  syncFlowchart(cur);
 }

 function syncFlowchart(cur){
  // 1. Single Explaining Slide with Morph Transition
  const slides = $$(".ppt-slide");
  if(slides && slides.length > 0){
   let activeIdx = 0;
   slides.forEach((slide, idx) => {
    const t0 = parseFloat(slide.dataset.t0 || "0");
    const t1 = parseFloat(slide.dataset.t1 || "9999");
    if(cur >= t0 && cur < t1){
     activeIdx = idx;
    }
   });

   slides.forEach((slide, idx) => {
    const wasActive = slide.classList.contains("active");
    const shouldBeActive = (idx === activeIdx);
    if(shouldBeActive && !wasActive){
     slide.classList.add("active");
    } else if(!shouldBeActive && wasActive){
     slide.classList.remove("active");
    }
   });

   // Update slide navigation dots
   const dots = $$(".ppt-nav-dot");
   if(dots && dots.length > 0){
    dots.forEach((dot, idx) => {
     dot.classList.toggle("active", idx === activeIdx);
     dot.classList.toggle("past", idx < activeIdx);
    });
   }

   // Update dock label
   const vtdLabel = $("#vtd-label");
   if(vtdLabel && slides[activeIdx]){
    const sTitle = slides[activeIdx].querySelector(".ppt-slide-title");
    vtdLabel.textContent = `Slide ${activeIdx + 1} of ${slides.length}: ${sTitle ? sTitle.textContent : ''}`;
   }
  }

  // 2. Legacy fallback
  const nodes = $$(".flow-node:not(.ppt-slide)");
  if(nodes && nodes.length > 0){
   nodes.forEach(node => {
    const t0 = parseFloat(node.dataset.t0 || "0");
    const t1 = parseFloat(node.dataset.t1 || "9999");
    const active = (cur >= t0 && cur < t1);
    node.classList.toggle("flow-active", active);
   });
  }
 }

 function vizOn(){
  cancelAnimationFrame(vraf);
  (function f(n){
   if(!playing || dead) return;
   const q = n / 1000 * speeds[si];
   bars.forEach((b, k) => {
    b.style.transform = "scaleY(" + (.55 + .45 * Math.sin(q * 5 + k * .6) * Math.cos(q * 2.3 + k * .21)).toFixed(3) + ")";
   });
   vraf = requestAnimationFrame(f);
  })(performance.now());
 }

 function vizOff(){
  cancelAnimationFrame(vraf);
  bars.forEach(b => { b.style.transform = ""; });
 }

 audio.addEventListener("loadedmetadata", () => {
  note.textContent = "Malayalam audio explainer ready · " + (p.voice || "Gemini Voice (Aoede)") + " (" + audioFile + ")";
  ui();
 });
 audio.addEventListener("canplay", () => { ui(); });
 audio.addEventListener("timeupdate", () => {
  if(playing) ui();
 });
 audio.addEventListener("ended", () => {
  finish();
 });
 audio.addEventListener("error", (e) => {
  console.error("Audio playback error:", e, audioUrl);
  note.textContent = "Could not load audio from " + audioUrl;
 });

 async function start(){
  try {
   audio.playbackRate = speeds[si];
   await audio.play();
   playing = true;
   root.classList.add("playing");
   playB.innerHTML = I.pause;
   playB.setAttribute("aria-label", "Pause audio");
   note.textContent = "Playing Malayalam explainer: " + (p.doctrine || "Statutory Rule") + " · " + (p.voice || "Gemini Voice (Aoede)");
   if(vtheater){
    if(vtheater.parentElement !== document.body){
     document.body.appendChild(vtheater);
    }
    vtheater.classList.add("vfullscreen");
    vtheater.style.display = "flex";
    document.body.style.overflow = "hidden";
    if(fvideo){
     fvideo.currentTime = audio.currentTime;
     fvideo.playbackRate = speeds[si];
     fvideo.play().catch(()=>{});
    }
   }
   const vtdPlay = $("#vtd-play");
   if(vtdPlay) vtdPlay.innerHTML = I.pause;
   vizOn();
  } catch(err) {
   console.warn("audio.play() error:", err);
   note.textContent = "Tap play to start audio playback (" + (err.message || "User interaction required") + ")";
   stop();
  }
 }

 function stop(){
  playing = false;
  try { audio.pause(); } catch(e){}
  if(fvideo){
   try { fvideo.pause(); } catch(e){}
  }
  if(vtheater){
   vtheater.classList.remove("vfullscreen");
   vtheater.style.display = "none";
   document.body.style.overflow = "";
  }
  const vtdPlay = $("#vtd-play");
  if(vtdPlay) vtdPlay.innerHTML = I.play;
  cancelAnimationFrame(vraf);
  vizOff();
  root.classList.remove("playing");
  playB.innerHTML = I.play;
  playB.setAttribute("aria-label", "Play audio");
 }

 function finish(){
  stop();
  audio.currentTime = 0;
  if(fvideo) fvideo.currentTime = 0;
  ui();
 }

 const togglePlay = (e) => {
  if (e) {
   e.preventDefault();
   e.stopPropagation();
  }
  if (playing) stop();
  else start();
 };

 playB.onclick = togglePlay;
 const wrap = root.querySelector(".playwrap");
 if (wrap) wrap.onclick = togglePlay;

 seek.oninput = () => {
  const T = total();
  const target = (seek.value / 1000) * T;
  if(isFinite(target)){
   audio.currentTime = target;
   if(fvideo) fvideo.currentTime = target;
  }
  ui();
 };

 spd.onclick = () => {
  si = (si + 1) % speeds.length;
  spd.textContent = speeds[si] === 1 ? "1.0x" : speeds[si] + "x";
  audio.playbackRate = speeds[si];
  if(fvideo) fvideo.playbackRate = speeds[si];
 };

 if(vtog){
  vtog.onclick = () => {
   const isShown = vtheater && vtheater.style.display !== "none";
   if(isShown){
    stop();
   } else {
    if(vtheater){
     if(vtheater.parentElement !== document.body){
      document.body.appendChild(vtheater);
     }
     vtheater.classList.add("vfullscreen");
     vtheater.style.display = "flex";
     document.body.style.overflow = "hidden";
     if(!playing) start();
    }
   }
  };
 }

 if(vclose){
  vclose.onclick = () => {
   if(vtheater) vtheater.style.display = "none";
   if(fvideo) try { fvideo.pause(); } catch(e){}
  };
 }

 $$(".flow-node").forEach(node => {
  node.onclick = (e) => {
   e.stopPropagation();
   const t0 = parseFloat(node.dataset.t0 || "0");
   audio.currentTime = t0;
   if(fvideo) fvideo.currentTime = t0;
   if(!playing) start();
   ui();
  };
 });

 const tabDiag = $("#vtab-diag");
 const tabVid = $("#vtab-vid");
 const vdiag = $("#vdiag");
 const vvidwrap = $("#vvidwrap");
 const vfs = $("#vfs");

 if(tabDiag && tabVid && vdiag && vvidwrap){
  tabDiag.onclick = () => {
   vdiag.style.display = "block";
   vvidwrap.style.display = "none";
   tabDiag.style.background = "var(--accent)";
   tabDiag.style.color = "#fff";
   tabDiag.style.borderColor = "var(--accent)";
   tabVid.style.background = "#F8FAFC";
   tabVid.style.color = "#475569";
   tabVid.style.borderColor = "#CBD5E1";
  };
  tabVid.onclick = () => {
   vdiag.style.display = "none";
   vvidwrap.style.display = "block";
   tabVid.style.background = "var(--accent)";
   tabVid.style.color = "#fff";
   tabVid.style.borderColor = "var(--accent)";
   tabDiag.style.background = "#F8FAFC";
   tabDiag.style.color = "#475569";
   tabDiag.style.borderColor = "#CBD5E1";
   if(fvideo){
    fvideo.currentTime = audio.currentTime;
    if(playing) fvideo.play().catch(()=>{});
   }
  };
 }

 if(vfs && vtheater){
  vfs.onclick = () => {
   vtheater.classList.toggle("vfullscreen");
   vfs.textContent = vtheater.classList.contains("vfullscreen") ? "✕ Exit Fullscreen" : "⛶ Fullscreen";
  };
 }

 // Wire up slide nav dots for instant slide-to-slide jump
 $$(".ppt-nav-dot").forEach(dot => {
  dot.onclick = (e) => {
   e.stopPropagation();
   const t0 = parseFloat(dot.dataset.t0 || "0");
   audio.currentTime = t0;
   if(fvideo) fvideo.currentTime = t0;
   if(!playing) start();
   ui();
  };
 });

 // Wire up dock controls in fullscreen presentation
 const vtdPlay = $("#vtd-play");
 if(vtdPlay) vtdPlay.onclick = togglePlay;
 const vtdSeek = $("#vtd-seek");
 if(vtdSeek){
  vtdSeek.oninput = () => {
   const T = total();
   const target = (vtdSeek.value / 1000) * T;
   if(isFinite(target)){
    audio.currentTime = target;
    if(fvideo) fvideo.currentTime = target;
   }
   ui();
  };
 }
 const vtdSpeed = $("#vtd-speed");
 if(vtdSpeed){
  vtdSpeed.onclick = () => {
   si = (si + 1) % speeds.length;
   const txt = speeds[si] === 1 ? "1.0x" : speeds[si] + "x";
   spd.textContent = txt;
   vtdSpeed.textContent = txt;
   audio.playbackRate = speeds[si];
   if(fvideo) fvideo.playbackRate = speeds[si];
  };
 }
 const vtdClose = $("#vtd-close");
 if(vtdClose) vtdClose.onclick = stop;

 // Escape key exits fullscreen presentation
 const escListener = (e) => {
  if(e.key === "Escape" && vtheater && vtheater.classList.contains("vfullscreen")){
   stop();
  }
 };
 window.addEventListener("keydown", escListener);

 note.textContent = "Spoken Malayalam audio explainer · " + (p.voice || "Gemini Voice (Aoede)");
 ui();

 return {
  destroy(){
   dead = true;
   if(fvideo){
    try { fvideo.pause(); fvideo.src = ""; } catch(e){}
   }
   stop();
   window.removeEventListener("keydown", escListener);
   if(vtheater && vtheater.parentElement === document.body){
    vtheater.remove();
   }
   audio.src = "";
  }
 };
}

/* ---------- global ---------- */
document.addEventListener("click",e=>{const g=e.target.closest("[data-go]");if(g&&!g.disabled){go(g.dataset.go)}
 const c=e.target.closest(".chip");if(c){chState.f=c.dataset.f;$$(".chip").forEach(x=>x.setAttribute("aria-pressed",x===c));drawChapters(parse())}});
document.addEventListener("keydown",e=>{if(parse().v!=="studio"||/INPUT|TEXTAREA/.test(e.target.tagName))return;
 const k=e.key==="ArrowRight"?"Next":e.key==="ArrowLeft"?"Prev":null;if(!k)return;
 const b=$$(".stepper .nav-btn").find(x=>x.textContent.trim()===k);if(b&&!b.disabled)b.click()});
addEventListener("scroll",()=>$("#bar").classList.toggle("scrolled",scrollY>8),{passive:true});
$("#themeBtn").onclick=()=>{const r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme: dark)").matches;
 const n=dark?"light":"dark";r.dataset.theme=n;store.set("tsTheme",n)};
(()=>{const t=store.get("tsTheme");if(t)document.documentElement.dataset.theme=t})();



/* network of drifting nodes that reacts to the pointer */
(function(){if(REDUCED)return;const cv=document.createElement("canvas");cv.id="net";$("#ambient").prepend(cv);const x=cv.getContext("2d");
 let W,H,P=[],mx=-999,my=-999,cols=["#888","#888","#888"],fr=0;
 const read=()=>{const c=getComputedStyle(document.body);cols=["--dt","--idt","--ink-2"].map(v=>c.getPropertyValue(v).trim())};
 function size(){const d=Math.min(2,devicePixelRatio||1);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;cv.style.width=W+"px";cv.style.height=H+"px";x.setTransform(d,0,0,d,0,0);
  const n=Math.round(Math.min(80,W*H/18000));P=Array.from({length:n},(_,i)=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,r:1.2+Math.random()*1.8,k:i%2}))}
 addEventListener("resize",size);addEventListener("pointermove",e=>{mx=e.clientX;my=e.clientY},{passive:true});
 (function f(){requestAnimationFrame(f);if(document.hidden)return;if(fr++%90===0)read();x.clearRect(0,0,W,H);
  for(const p of P){p.x+=p.vx;p.y+=p.vy;if(p.x<-20)p.x=W+20;if(p.x>W+20)p.x=-20;if(p.y<-20)p.y=H+20;if(p.y>H+20)p.y=-20;
   const dx=p.x-mx,dy=p.y-my,d=Math.hypot(dx,dy);if(d<150&&d>0){p.x+=dx/d*(150-d)*.012;p.y+=dy/d*(150-d)*.012}}
  x.lineWidth=1;
  for(let i=0;i<P.length;i++){const a=P[i];
   for(let j=i+1;j<P.length;j++){const b=P[j],d=Math.hypot(a.x-b.x,a.y-b.y);if(d<130){x.globalAlpha=(1-d/130)*.3;x.strokeStyle=cols[a.k];x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}}
   const dm=Math.hypot(a.x-mx,a.y-my);if(dm<170){x.globalAlpha=(1-dm/170)*.55;x.strokeStyle=cols[1-a.k];x.beginPath();x.moveTo(a.x,a.y);x.lineTo(mx,my);x.stroke()}
   x.globalAlpha=.7;x.fillStyle=cols[a.k];x.beginPath();x.arc(a.x,a.y,a.r,0,7);x.fill()}
  x.globalAlpha=1})();size();read()})();

/* 3D tilt for the subject doors, spotlight for every other card */
app.addEventListener("pointermove",e=>{
 const d=e.target.closest(".door");
 if(d&&!REDUCED){const b=d.getBoundingClientRect(),px=(e.clientX-b.left)/b.width*2-1,py=(e.clientY-b.top)/b.height*2-1;
  d.classList.remove("leave");d.style.setProperty("--rx",(-py*5).toFixed(2)+"deg");d.style.setProperty("--ry",(px*6).toFixed(2)+"deg");d.style.setProperty("--px",px.toFixed(2));d.style.setProperty("--py",py.toFixed(2))}
 const c=e.target.closest(".row,.q,.stage,.cluster");
 if(c){const b=c.getBoundingClientRect();c.style.setProperty("--mx",e.clientX-b.left+"px");c.style.setProperty("--my",e.clientY-b.top+"px")}});
app.addEventListener("pointerout",e=>{const d=e.target.closest(".door");if(d&&!d.contains(e.relatedTarget)){d.classList.add("leave");["--rx","--ry","--px","--py"].forEach(v=>d.style.removeProperty(v))}});

/* reading progress */
const prog=document.createElement("div");prog.className="prog";document.body.appendChild(prog);
addEventListener("scroll",()=>{const h=document.documentElement.scrollHeight-innerHeight;prog.style.transform="scaleX("+(h>0?Math.min(1,scrollY/h):0).toFixed(4)+")"},{passive:true});



if(synthOK()){try{speechSynthesis.getVoices()}catch(e){}}
function synthOK(){return"speechSynthesis"in window}
render();
</script>
</body></html>
