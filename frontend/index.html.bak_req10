<script type="application/json" id="pipeline-data">
{"catalog": {"subject": "Direct Tax", "total_chapters": 25, "chapters": [{"chapter_number": 1, "title": "Basic Concepts, Tax Rates and Exempt Income", "page_range": "1.1 - 1.18"}, {"chapter_number": 2, "title": "Capital Gains", "page_range": "2.1 - 2.39"}, {"chapter_number": 3, "title": "Profits and Gains of Business or Profession (PGBP)", "page_range": "3.1 - 3.111"}, {"chapter_number": 4, "title": "Income from Other Sources", "page_range": "4.1 - 4.17"}, {"chapter_number": 5, "title": "Clubbing of Income", "page_range": "5.1 - 5.8"}, {"chapter_number": 6, "title": "Set-off and Carry forward of Losses", "page_range": "6.1 - 6.8"}, {"chapter_number": 7, "title": "Deductions under Chapter VI-A and Section 10AA", "page_range": "7.1 - 7.18"}, {"chapter_number": 8, "title": "Assessment/Taxation of Various Entities (Cooperative Society, AOP, AMT, MAT, Tonnage Tax, Business Trust, Investment Fund, Securitisation Trust)", "page_range": "8.1 - 8.58"}, {"chapter_number": 9, "title": "Charitable Trusts, Political Parties and Electoral Trusts", "page_range": "9.1 - 9.43"}, {"chapter_number": 10, "title": "TDS, TCS, Advance Tax, Interest and Refund", "page_range": "10.1 - 10.52"}, {"chapter_number": 11, "title": "Income Tax Authorities, Return Filing & Assessment Procedure", "page_range": "11.1 - 11.28"}, {"chapter_number": 12, "title": "Appeals and Revision", "page_range": "12.1 - 12.12"}, {"chapter_number": 13, "title": "Dispute Resolution", "page_range": "13.1 - 13.2"}, {"chapter_number": 14, "title": "Penalties, Offences and Prosecution", "page_range": "14.1 - 14.13"}, {"chapter_number": 15, "title": "Miscellaneous Provisions", "page_range": "15.1 - 15.9"}, {"chapter_number": 16, "title": "Tax Planning, Tax Evasion & Tax Avoidance (GAAR)", "page_range": "16.1 - 16.11"}, {"chapter_number": 17, "title": "Tax Audit and Ethical Compliances", "page_range": "17.1 - 17.10"}, {"chapter_number": 18, "title": "The Black Money & Imposition of Tax Law", "page_range": "18.1 - 18.5"}, {"chapter_number": 19, "title": "Double Taxation Relief", "page_range": "19.1 - 19.41"}, {"chapter_number": 20, "title": "Non Resident Taxation", "page_range": "20.1 - 20.57"}, {"chapter_number": 21, "title": "Transfer Pricing", "page_range": "21.1 - 21.42"}, {"chapter_number": 22, "title": "Advance Rulings", "page_range": "22.1 - 22.5"}, {"chapter_number": 23, "title": "Fundamentals of BEPS", "page_range": "23.1 - 23.8"}, {"chapter_number": 24, "title": "Application and Interpretation of Tax Treaties", "page_range": "24.1 - 24.7"}, {"chapter_number": 25, "title": "Overview of Model Tax Conventions", "page_range": "25.1 - 25.6"}]}, "questions": [{"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 1, "question_title": "Application of Income vs Diversion of Income by Overriding Title", "question_text": "Mr. Bhargava, a leading advocate on corporate law, decided to reduce his practice and to accept briefs only for paying his taxes and making charities with fees received on such briefs. In a particular case, he agreed to appear to defend one company in Supreme Court on the condition that he would be provided with ₹ 5 lacs for a public charitable trust that he would create. He defended the company and was paid the sum by company. He created a trust of that sum by executing a trust deed. Decide whether the amount received by Mr. Bhargava is assessable in his hands as income from profession.", "answer_text": "In the instant case, the trust was created by Mr. Bhargava himself out of his professional income. The client did not create the trust. The client did not impose any obligation in the nature of a trust binding on Mr. Bhargava. Thus, there is no diversion of the money to the trust before it became professional income in the hands of Mr. Bhargava. This case is one of application of professional income and not of diversion of income by overriding title. Therefore, the amount received by Mr. Bhargava is chargeable to tax under the head \"Profits and gains of business or profession\"."}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 2, "question_title": "Diversion of Income by Overriding Charge on Takeover of Business", "question_text": "XYZ Ltd. took over the running business of a sole-proprietor by a sale deed. As per the sale deed, XYZ Ltd. undertook to pay overriding charges of ₹ 15,000 p.a. to the wife of the sole-proprietor in addition to the sale consideration. The sale deed also specifically mentioned that the amount was charged on the net profits of XYZ Ltd., who had accepted that obligation as a condition of purchase of the going concern. Is the payment of overriding charges by XYZ Ltd. to the wife of the sole-proprietor in the nature of diversion of income or application of income? Discuss.", "answer_text": "This issue came up for consideration before the Allahabad High Court in Jit & Pal X-Rays (P.) Ltd. v. CIT (2004) 267 ITR 370 (All). The Allahabad High Court observed that the overriding charge which had been created in favour of the wife of the sole-proprietor was an integral part of the sale deed by which the going concern was transferred to the assessee. The obligation, therefore, was attached to the very source of income i.e. the going concern transferred to the assessee by the sale deed. The sale deed also specifically mentioned that the amount in question was charged on the net profits of the assessee-company and the assessee-company had accepted that obligation as a condition of purchase of the going concern. Hence, it is clearly a case of diversion of income by an overriding charge and not a mere application of income."}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 3, "question_title": "Diversion of Partnership Profits by Overriding Title to Deceased Partner's Mother", "question_text": "MKG Agency is a partnership firm consisting of father and three major sons. The partnership deed provided that after the death of father, the business shall be continued by the sons, subject to the condition that the firm shall pay 20% of the profits to the mother. Father died in March, 2025. In the previous year 2025-26, the reconstituted firm paid ₹ 1 lakh (equivalent to 20% of the profits) to the mother and claimed the amount as deduction from its income. Examine the correctness of the claim of the firm.", "answer_text": "The issue raised in the problem is based on the concept of diversion of income by overriding title, which is well recognised in the income-tax law. In the instant case, the amount of ₹ 1 lakh, being 20% of profits of the firm, paid to the mother gets diverted at source by the charge created in her favour as per the terms of the partnership deed. Such income does not reach the assessee-firm.\n\nRather, such income stands diverted to the other person as such other person has a better title on such income than the title of the assessee. The firm might have received the said amount but it so received for and on behalf of the mother, who possesses the overriding title. Therefore, the amount paid to the mother should be excluded from the income of the firm. This view has been confirmed in CIT vs. Nariman B. Bharucha & Sons (1981) 130 ITR 863 (Bom)."}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 4, "question_title": "Computation of Tax Liability under Normal Provisions (Opting Out of Default Regime) for Different Age Slabs", "question_text": "Mr. Arjun has a total income of ₹ 16,00,000, comprising of income from house property and interest on fixed deposits. Compute his tax liability for A.Y.2026-27 assuming his age is -\n(a) 52 years\n(b) 64 years\n(c) 83 years\nAssume that Mr. Arjun has exercised the option to shift out/opt out of the default tax regime.", "answer_text": "**(a) Computation of Tax liability of Mr. Arjun (aged 52 years)**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| First ₹ 2,50,000 | Nil |\n| Next ₹ 2,50,001 - ₹ 5,00,000 @ 5% of ₹ 2,50,000 | 12,500 |\n| Next ₹ 5,00,001 - ₹ 10,00,000 @ 20% of ₹ 5,00,000 | 1,00,000 |\n| Balance i.e., ₹ 16,00,000 minus ₹ 10,00,000 @ 30% of ₹ 6,00,000 | 1,80,000 |\n| **Total** | **2,92,500** |\n| Add: Health and Education cess @ 4% | 11,700 |\n| **Tax liability** | **3,04,200** |\n\n**(b) Computation of Tax liability of Mr. Arjun (aged 64 years)**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| First ₹ 3,00,000 | Nil |\n| Next ₹ 3,00,001 - ₹ 5,00,000 @ 5% of ₹ 2,00,000 | 10,000 |\n| Next ₹ 5,00,001 - ₹ 10,00,000 @ 20% of ₹ 5,00,000 | 1,00,000 |\n| Balance i.e., ₹ 16,00,000 minus ₹ 10,00,000 @ 30% of ₹ 6,00,000 | 1,80,000 |\n| **Total** | **2,90,000** |\n| Add: Health and Education cess @ 4% | 11,600 |\n| **Tax liability** | **3,01,600** |\n\n**(c) Computation of Tax liability of Mr. Arjun (aged 83 years)**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| First ₹ 5,00,000 | Nil |\n| Next ₹ 5,00,001 - ₹ 10,00,000 @ 20% of ₹ 5,00,000 | 1,00,000 |\n| Balance i.e., ₹ 16,00,000 minus ₹ 10,00,000 @ 30% of ₹ 6,00,000 | 1,80,000 |\n| **Total** | **2,80,000** |\n| Add: Health and Education cess @ 4% | 11,200 |\n| **Tax liability** | **2,91,200** |"}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 5, "question_title": "Computation of Tax Liability and Rebate u/s 87A under Normal Provisions", "question_text": "Mr. Manish, aged 47 years and a resident in India, has a total income of ₹ 4,15,000, comprising his salary income and interest on bank fixed deposit. Compute his tax liability for A.Y.2026-27 if he exercises the option to shift out of the default tax regime.", "answer_text": "**Computation of tax liability of Mr. Manish**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| Tax @ 5% of ₹ 1,65,000 (₹ 4,15,000 - ₹ 2,50,000) | 8,250 |\n| Less: Rebate u/s 87A (Lower of tax payable or ₹ 12,500) | (8,250) |\n| **Tax Liability** | **Nil** |"}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 6, "question_title": "Computation of Tax Liability under Default Tax Regime u/s 115BAC", "question_text": "Mr. X has a total income of ₹ 16,00,000, comprising of income from house property and interest on fixed deposits. Compute his tax liability for A.Y.2026-27 under the default tax regime u/s 115BAC.", "answer_text": "**Computation of Tax liability of Mr. X**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| First ₹ 4,00,000 | Nil |\n| Next ₹ 4,00,001 - ₹ 8,00,000 @ 5% of ₹ 4,00,000 | 20,000 |\n| Next ₹ 8,00,001 - ₹ 12,00,000 @ 10% of ₹ 4,00,000 | 40,000 |\n| Next ₹ 12,00,001 - ₹ 16,00,000 @ 15% of ₹ 4,00,000 | 60,000 |\n| **Total** | **1,20,000** |\n| Add: Health and Education cess @ 4% | 4,800 |\n| **Tax liability** | **1,24,800** |"}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 7, "question_title": "Rebate u/s 87A under Default Tax Regime u/s 115BAC", "question_text": "Mr. Mahesh aged 32 years and a resident in India, has a total income of ₹ 11,00,000, comprising his salary income and interest on bank fixed deposit. Compute his tax liability for A.Y.2026-27 under default tax regime under section 115BAC.", "answer_text": "**Computation of tax liability of Mr. Mahesh**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| First ₹ 4,00,000 | Nil |\n| Next ₹ 4,00,001 — ₹ 8,00,000 (₹ 4,00,000 × 5%) | 20,000 |\n| Balance ₹ 8,00,001 - ₹ 11,00,000 (₹ 3,00,000 × 10%) | 30,000 |\n| **Total** | **50,000** |\n| Less: Rebate u/s 87A (Lower of tax payable or ₹ 60,000) | (50,000) |\n| **Tax Liability** | **Nil** |"}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 8, "question_title": "Marginal Rebate u/s 87A under Default Tax Regime u/s 115BAC", "question_text": "Mr. Nitin aged 35 years and a resident in India, has a total income of ₹ 12,50,000, comprising his salary income and interest on bank fixed deposit. Compute his tax liability for A.Y.2026-27 under default tax regime under section 115BAC.", "answer_text": "**Computation of tax liability of Mr. Nitin**\n\n| Particulars | Amount (₹) |\n| :--- | :--- |\n| **Step 1:** Total Income of ₹ 12,50,000 - ₹ 12,00,000 (A) | 50,000 |\n| **Step 2:** Tax on total income of ₹ 12,50,000: Tax @ 15% of ₹ 50,000 + ₹ 60,000 (B) | 67,500 |\n| **Step 3:** Since B > A, rebate u/s 87A would be B - A (₹ 67,500 - ₹ 50,000) | (17,500) |\n| **Tax before cess** | **50,000** |\n| Add: HEC @ 4% | 2,000 |\n| **Tax Liability** | **52,000** |"}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 9, "question_title": "Marginal Relief for Domestic Company (Total Income Exceeding ₹ 1 Crore)", "question_text": "Compute the marginal relief available to X Ltd., a domestic company, assuming that the total income of X Ltd. is ₹ 1,01,00,000 for A.Y.2026-27 and the total income does not include any income in the nature of capital gains. Assume that the company has not exercised option under section 115BAA or 115BAB.\n[Note - The gross receipts of X Ltd. for the P.Y.2023-24 is ₹ 402 crore]", "answer_text": "The tax payable on total income of ₹ 1,01,00,000 of X Ltd. computed @ 32.1% (including surcharge @ 7%) is ₹ 32,42,100.\n\nHowever, the tax cannot exceed ₹ 31,00,000 (i.e., the tax of ₹ 30,00,000 payable on total income of ₹ 1 crore plus ₹ 1,00,000, being the amount of total income exceeding ₹ 1 crore).\n\nTherefore, the tax payable on ₹ 1,01,00,000 would be ₹ 31,00,000.\n\nThe marginal relief is ₹ 1,42,100 (i.e., ₹ 32,42,100 - ₹ 31,00,000)."}, {"chapter_number": 1, "chapter_title": "Basic Concepts, Tax Rates and Exempt Income", "question_number": 10, "question_title": "Marginal Relief for Domestic Company (Total Income Exceeding ₹ 10 Crore)", "question_text": "Compute the marginal relief available to Y Ltd., a domestic company, assuming that the total income of Y Ltd. for A.Y.2026-27 is ₹ 10,01,00,000 and the total income does not include any income in the nature of capital gains. Assume that the company has not exercised option under section 115BAA or 115BAB.\n[Note - The gross receipts of Y Ltd. for the P.Y.2023-24 is ₹ 410 crore]", "answer_text": "The tax payable on total income of ₹ 10,01,00,000 of Y Ltd. computed @ 33.6% (including surcharge @ 12%) is ₹ 3,36,33,600.\n\nHowever, tax cannot exceed ₹ 3,22,00,000 [i.e., the tax of ₹ 3,21,00,000 (32.1% of ₹ 10 crore) payable on total income of ₹ 10 crore plus ₹ 1,00,000, being the amount of total income exceeding ₹ 10 crore].\n\nTherefore, the tax payable on ₹ 10,01,00,000 would be ₹ 3,22,00,000.\n\nThe marginal relief is ₹ 14,33,600 (i.e., ₹ 3,36,33,600 - ₹ 3,22,00,000)."}], "provisions": [{"question_number": 1, "statutory_sections": ["Section 4", "Section 28"], "core_principle": "Diversion of Income by Overriding Title vs. Application of Income", "provision_presentation_markdown": "### **Doctrine: Diversion vs. Application of Income**\n\n| Basis of Distinction | Diversion by Overriding Title | Application of Income |\n| :--- | :--- | :--- |\n| **Point of Transfer** | Diverted **at source** before reaching the assessee. | Applied **after** the income reaches or accrues to the assessee. |\n| **Nature of Obligation** | Enforceable legal/statutory obligation overriding assessee's title. | Voluntary obligation or self-imposed condition by the assessee. |\n| **Title to Income** | Assessee never acquires title or ownership over such income. | Assessee acquires full beneficial ownership before applying it. |\n| **Taxability** | **Not taxable** in the hands of the assessee. | **Taxable** in the hands of the assessee under relevant head. |\n\n> **Key Precedent (*CIT v. Thakar Das Bhargava*)**  \n> Where an advocate receives professional fees subject to a self-created desire or voluntary agreement to allocate it to a charitable trust, it is merely an **application of income** and remains fully taxable as professional earnings under **Section 28**.", "malayalam_audio_script": "ആദായനികുതി നിയമപ്രകാരം വരുമാനം ഒരാളുടെ കൈവശം എത്തുന്നതിന് മുൻപ് തന്നെ ഏതെങ്കിലും നിയമപരമായ ബാധ്യത മൂലം മറ്റൊരു വ്യക്തിയിലേക്ക് വഴിതിരിച്ചുവിടപ്പെടുകയാണെങ്കിൽ, അതിനെ 'Diversion of Income by Overriding Title' എന്ന് വിളിക്കുന്നു. അത്തരം തുക വരുമാനമായി കണക്കാക്കില്ല, അതിനാൽ നികുതിവിധേയവുമല്ല. എന്നാൽ വരുമാനം ഒരാൾക്ക് ലഭിക്കുകയോ നിയമപരമായി അവകാശപ്പെടാൻ അർഹത നേടുകയോ ചെയ്തതിന് ശേഷം, ആ തുക ചാരിറ്റിക്കോ മറ്റേതെങ്കിലും ആവശ്യങ്ങൾക്കോ മാറ്റിവെക്കുകയാണെങ്കിൽ, അത് 'Application of Income' മാത്രമാണ്. ഇവിടെ വരുമാനത്തിന്മേൽ ആദ്യം തന്നെ വ്യക്തിക്ക് പൂർണ്ണമായ അവകാശം വരുന്നതുകൊണ്ട്, അത് ബിസിനസ് അല്ലെങ്കിൽ പ്രൊഫഷണൽ വരുമാനമായി കണക്കാക്കി നികുതി ചുമത്തപ്പെടും.", "topic_id": "diversion_of_income_by_overriding_title_", "topic_title": "Diversion of Income by Overriding Title vs. Application of Income", "audio_file": "q1.mp3"}, {"question_number": 2, "statutory_sections": ["Section 4"], "core_principle": "Diversion of Income by Overriding Title vs. Application of Income", "provision_presentation_markdown": "### Doctrine: Diversion vs. Application of Income\n\n| Basis of Distinction | Diversion of Income by Overriding Title | Application of Income |\n| :--- | :--- | :--- |\n| **Nature of Obligation** | Obligation is attached to the **source** itself. | Obligation arises **after** the income reaches the assessee. |\n| **Timing of Transfer** | Income is diverted **before** it reaches or accrues to the assessee. | Income is spent/discharged **after** it has accrued or been received. |\n| **Taxability** | **Not taxable** in the hands of the assessee (excluded from Total Income). | **Fully taxable** in the hands of the assessee (no deduction allowed). |\n| **Legal Benchmark** | Landmark Ruling: *CIT v. Sitaldas Tirathdas (SC)*. | General principle of utilization of earned profits. |\n\n> **Key Test (Jit & Pal X-Rays (P.) Ltd.):**\n> Where an obligation to pay an overriding charge is an **integral condition of the purchase deed** and attached directly to the source of income (the business undertaking), it is a **Diversion of Income by Overriding Title** and not an application of profit.", "malayalam_audio_script": "ഇൻകം ടാക്സ് നിയമത്തിൽ വരുമാനത്തിന്റെ ചാർജബിലിറ്റി നിർണ്ണയിക്കുന്ന പ്രധാനപ്പെട്ട ഒരു തത്വമാണ് ഡൈവേർഷൻ ഓഫ് ഇൻകം ബൈ ഓവർറൈഡിംഗ് ടൈറ്റിൽ. ഒരു അസ്സസ്സിയുടെ വരുമാന സ്രോതസ്സിൽ തന്നെ നിയമപരമായ ബാധ്യത അഥവാ ഓവർറൈഡിംഗ് ചാർജ്ജ് മുൻകൂട്ടി നിലനിൽക്കുകയും, ആ വരുമാനം അസ്സസ്സിയിൽ എത്തുന്നതിന് തൊട്ടുമുൻപ് തന്നെ മൂന്നാമതൊരാളിലേക്ക് വഴിതിരിച്ചുവിടപ്പെടുകയും ചെയ്യുകയാണെങ്കിൽ, അതിനെ 'ഡൈവേർഷൻ ഓഫ് ഇൻകം' എന്ന് വിളിക്കുന്നു. ഇത്തരം തുക അസ്സസ്സിയുടെ ടോട്ടൽ ഇൻകത്തിൽ ഉൾപ്പെടില്ല, ടാക്സ് നൽകേണ്ടതുമില്ല. എന്നാൽ, വരുമാനം അസ്സസ്സിക്ക് ലഭിച്ചതിന് ശേഷം സ്വന്തം ഇഷ്ടപ്രകാരമോ കരാർ പ്രകാരമോ ചിലവഴിക്കുകയാണെങ്കിൽ, അത് 'ആപ്ലിക്കേഷൻ ഓഫ് ഇൻകം' മാത്രമാണ്. ആ തുകയ്ക്ക് അസ്സസ്സി പൂർണ്ണമായും ടാക്സ് നൽകാൻ ബാധ്യസ്ഥനാണ്.", "topic_id": "diversion_of_income_by_overriding_title_", "topic_title": "Diversion of Income by Overriding Title vs. Application of Income", "audio_file": "q1.mp3"}, {"question_number": 3, "statutory_sections": ["Section 4"], "core_principle": "Diversion of Income by Overriding Title vs. Application of Income", "provision_presentation_markdown": "### ⚖️ Diversion of Income vs. Application of Income\n\n| Basis of Distinction | Diversion by Overriding Title | Application of Income |\n| :--- | :--- | :--- |\n| **Point of Transfer** | Diverted **at source** before reaching the assessee | Applied **after** the income reaches / accrues to the assessee |\n| **Nature of Obligation** | Created by an overriding, pre-existing legal charge or superior title | Merely an obligation to apply income that has already accrued |\n| **Ownership of Funds** | Assessee receives it merely on behalf of the real title-holder | Assessee receives it as their own real income |\n| **Tax Treatment** | **Excluded** from Total Income (Not taxable) | **Included** in Total Income (No deduction allowed) |\n\n---\n\n#### 📌 The Supreme Court Benchmark *(CIT vs. Sitaldas Tirathdas)*\n* **The Decisive Test:** *Does the money reach the assessee as his own income before being applied, or is it diverted before it ever reaches him by virtue of an overriding enforceable obligation?*\n* **Partnership Stipulation:** Where a partnership deed creates a charge on profits in favour of a deceased partner’s legal heir (e.g., widow) as a condition precedent for business continuation, the payment constitutes **diversion of income at source** *(CIT vs. Nariman B. Bharucha & Sons)*.", "malayalam_audio_script": "വരുമാനം ഒരു വ്യക്തിയിലേക്ക് അല്ലെങ്കിൽ ഒരു സ്ഥാപനത്തിലേക്ക് എത്തുന്നതിനു മുൻപ് തന്നെ, നിയമപരമായ ഒരു ബാധ്യത മൂലമോ കരാർ വ്യവസ്ഥ മൂലമോ മറ്റൊരു വ്യക്തിയിലേക്ക് വഴിതിരിച്ചുവിടപ്പെടുകയാണെങ്കിൽ, അതിനെയാണ് Diversion of Income by Overriding Title എന്ന് പറയുന്നത്. ഇവിടെ പണം സ്വീകരിക്കുന്നയാൾക്ക് അതിന്മേൽ പൂർണ്ണമായ ഉടമസ്ഥാവകാശം ഉണ്ടാകുന്നില്ല, മറിച്ച് മറ്റൊരാൾക്ക് വേണ്ടിയാണ് ആ തുക കൈപ്പറ്റുന്നത്. അതുകൊണ്ടുതന്നെ അത്തരം തുക സ്വീകർത്താവിന്റെ ആകെ വരുമാനത്തിൽ ഉൾപ്പെടുത്തി നികുതി ചുമത്താൻ കഴിയില്ല. നേരെമറിച്ച്, വരുമാനം കൈപ്പറ്റിയ ശേഷമാണ് ഒരാൾ തന്റെ ബാധ്യതകൾ നിറവേറ്റാൻ അത് ഉപയോഗിക്കുന്നതെങ്കിൽ, അത് Application of Income ആണ്, അതിന്മേൽ പൂർണ്ണമായും നികുതി നൽകേണ്ടി വരും.", "topic_id": "diversion_of_income_by_overriding_title_", "topic_title": "Diversion of Income by Overriding Title vs. Application of Income", "audio_file": "q1.mp3"}, {"question_number": 4, "statutory_sections": ["Section 4", "Section 115BAC(6)", "Annual Finance Act (First Schedule, Part I)"], "core_principle": "Age-Based Progressive Slab Rates under the Optional (Old) Tax Regime", "provision_presentation_markdown": "### Tax Rates under Optional / Normal Regime (Old Regime)\n\n| Total Income Slab | Resident < 60 Years | Senior Citizen (60 to < 80 Years) | Super Senior Citizen (80+ Years) |\n| :--- | :---: | :---: | :---: |\n| **Up to ₹ 2,50,000** | **Nil** | **Nil** | **Nil** |\n| **₹ 2,50,001 – ₹ 3,00,000** | 5% | **Nil** *(Exempt up to ₹ 3L)* | **Nil** *(Exempt up to ₹ 5L)* |\n| **₹ 3,00,001 – ₹ 5,00,000** | 5% | 5% | **Nil** |\n| **₹ 5,00,001 – ₹ 10,00,000** | 20% | 20% | 20% |\n| **Above ₹ 10,00,000** | 30% | 30% | 30% |\n\n#### Additional Statutory Levies & Relief\n* **Health and Education Cess (HEC):** Mandatory **4%** on aggregate income-tax (plus surcharge, if any).\n* **Rebate u/s 87A:** Available up to **₹ 12,500** for resident individuals having Total Income up to **₹ 5,00,000**.\n* **Surcharge:** Applicable only if Total Income exceeds **₹ 50 Lakhs**.", "malayalam_audio_script": "സെക്ഷൻ 115BAC പ്രകാരമുള്ള ഡിഫോൾട്ട് ടാക്സ് റെജിമിൽ നിന്ന് ഒപ്റ്റ് ഔട്ട് ചെയ്യുമ്പോൾ, ഒരു റെസിഡന്റ് വ്യക്തിയുടെ നികുതി നിരക്ക് അവരുടെ പ്രായത്തെ അടിസ്ഥാനമാക്കിയാണ് നിർണ്ണയിക്കുന്നത്. അറുപത് വയസ്സിന് താഴെയുള്ള വ്യക്തികൾക്ക് രണ്ടര ലക്ഷം രൂപ വരെ നികുതിയില്ല. 2.5 ലക്ഷം മുതൽ 5 ലക്ഷം വരെ 5 ശതമാനവും, 5 മുതൽ 10 ലക്ഷം വരെ 20 ശതമാനവും, 10 ലക്ഷത്തിന് മുകളിലുള്ള തുകയ്ക്ക് 30 ശതമാനവുമാണ് ടാക്സ് നിരക്ക്. എന്നാൽ 60 വയസ്സോ അതിൽ കൂടുതലോ പ്രായമുള്ള സീനിയർ സിറ്റിസൺസിന് ബേസിക് എക്സംപ്ഷൻ ലിമിറ്റ് 3 ലക്ഷം രൂപയാണ്. അതുകൊണ്ട് 3 ലക്ഷം മുതൽ 5 ലക്ഷം വരെയുള്ള തുകയ്ക്ക് മാത്രമേ 5 ശതമാനം ബാധകമാകൂ. 80 വയസ്സോ അതിൽ കൂടുതലോ പ്രായമുള്ള സൂപ്പർ സീനിയർ സിറ്റിസൺസിന് 5 ലക്ഷം രൂപ വരെ പൂർണ്ണമായും നികുതിയില്ല. അവർക്ക് 5 മുതൽ 10 ലക്ഷം വരെ 20 ശതമാനവും, 10 ലക്ഷത്തിന് മുകളിൽ 30 ശതമാനവും നികുതി വരുന്നു. ഇത്തരത്തിൽ ലഭിക്കുന്ന മൊത്തം നികുതിയുടെ കൂടെ 4 ശതമാനം ഹെൽത്ത് ആൻഡ് എഡ്യൂക്കേഷൻ സെസ്സ് നിർബന്ധമായും നൽകേണ്ടതുണ്ട്.", "topic_id": "age_based_progressive_slab_rates_under_t", "topic_title": "Age-Based Progressive Slab Rates under the Optional (Old) Tax Regime", "audio_file": "q4.mp3"}, {"question_number": 5, "statutory_sections": ["Section 87A", "Section 115BAC(6)"], "core_principle": "Tax Slabs & Section 87A Rebate under Normal Tax Provisions (Old Regime)", "provision_presentation_markdown": "### Tax Rates for Individuals (< 60 Years) — Old Regime\n\n| Total Income Slab | Applicable Tax Rate |\n| :--- | :--- |\n| **Up to ₹ 2,50,000** | **Nil** (Basic Exemption Limit) |\n| **₹ 2,50,001 – ₹ 5,00,000** | **5%** of amount exceeding ₹ 2,50,000 |\n| **₹ 5,00,001 – ₹ 10,00,000** | ₹ 12,500 + **20%** of amount exceeding ₹ 5,00,000 |\n| **Above ₹ 10,00,000** | ₹ 1,12,500 + **30%** of amount exceeding ₹ 10,00,000 |\n\n---\n\n### Rebate under Section 87A (Old Regime)\n\n* **Eligibility:** Resident Individual only.\n* **Income Threshold:** Total Income **≤ ₹ 5,00,000**.\n* **Rebate Quantum:** Lower of **100% of income-tax payable** or **₹ 12,500**.\n* **Health & Education Cess:** 4% applicable on tax payable after deducting Section 87A rebate.", "malayalam_audio_script": "പഴയ ടാക്സ് റെജിം തിരഞ്ഞെടുക്കുന്ന അറുപത് വയസ്സിൽ താഴെയുള്ള ഒരു റെസിഡന്റ് വ്യക്തിക്ക് അടിസ്ഥാന ഇളവ് പരിധി രണ്ടര ലക്ഷം രൂപയാണ്. രണ്ടര ലക്ഷം മുതൽ അഞ്ച് ലക്ഷം രൂപ വരെയുള്ള വരുമാനത്തിന് അഞ്ച് ശതമാനമാണ് നികുതി നിരക്ക്. ഒരു റെസിഡന്റ് വ്യക്തിയുടെ ആകെ വരുമാനം അഞ്ച് ലക്ഷം രൂപയിൽ താഴെയാണെങ്കിൽ, സെക്ഷൻ 87A പ്രകാരം പരമാവധി പന്ത്രണ്ടായിരത്തി അഞ്ഞൂറ് രൂപ വരെയോ അല്ലെങ്കിൽ യഥാർത്ഥ നികുതി തുകയോ, ഇതിൽ ഏതാണോ കുറവ്, അത് റിബേറ്റായി ലഭിക്കുന്നതാണ്. അതുകൊണ്ടുതന്നെ, വരുമാനം അഞ്ച് ലക്ഷം രൂപയിൽ കവിയുന്നില്ലെങ്കിൽ നികുതി ബാധ്യത പൂർണ്ണമായും ഒഴിവാകുന്നതാണ്.", "topic_id": "tax_slabs_section_87a_rebate_under_norma", "topic_title": "Tax Slabs & Section 87A Rebate under Normal Tax Provisions (Old Regime)", "audio_file": "q5.mp3"}, {"question_number": 6, "statutory_sections": ["Section 4", "Section 115BAC(1A)"], "core_principle": "Default Tax Regime Slab Rates for Individuals u/s 115BAC(1A)", "provision_presentation_markdown": "### **Tax Slabs u/s 115BAC(1A) (Default Tax Regime)**\n*Applicable for Individuals, HUF, AOP, BOI & AJP (A.Y. 2025-26 & A.Y. 2026-27)*\n\n| Total Income Slab (₹) | Rate of Tax |\n| :--- | :---: |\n| **Up to ₹ 4,00,000** | **Nil** |\n| **₹ 4,00,001 – ₹ 8,00,000** | **5%** |\n| **₹ 8,00,001 – ₹ 12,00,000** | **10%** |\n| **₹ 12,00,001 – ₹ 16,00,000** | **15%** |\n| **₹ 16,00,001 – ₹ 20,00,000** | **20%** |\n| **₹ 20,00,001 – ₹ 24,00,000** | **25%** |\n| **Above ₹ 24,00,000** | **30%** |\n\n---\n\n#### **Key Statutory Highlights**\n* **Uniform Basic Exemption:** ₹ 4,00,000 applies universally across all age categories (no enhanced limit for Senior or Super Senior citizens).\n* **Health & Education Cess:** 4% levied on aggregate income-tax.\n* **Rebate u/s 87A:** Available up to ₹ 25,000 if Total Income does not exceed ₹ 7,00,000.", "malayalam_audio_script": "സെക്ഷൻ 115BAC സബ് സെക്ഷൻ (1A) പ്രകാരം വ്യക്തികളുടെ നികുതി കണക്കാക്കുന്നത് പരിഷ്കരിച്ച ഡീഫോൾട്ട് ടാക്സ് സ്ലാബുകൾ അടിസ്ഥാനമാക്കിയാണ്. ഇതനുസരിച്ച് ആദ്യത്തെ നാല് ലക്ഷം രൂപ വരെയുള്ള വരുമാനത്തിന് നികുതി പൂർണ്ണമായും ഒഴിവാക്കിയിരിക്കുന്നു. നാല് ലക്ഷം മുതൽ എട്ട് ലക്ഷം രൂപ വരെയുള്ള തുകയ്ക്ക് അഞ്ച് ശതമാനവും, എട്ട് ലക്ഷം മുതൽ പന്ത്രണ്ട് ലക്ഷം വരെയുള്ള തുകയ്ക്ക് പത്ത് ശതമാനവും, പന്ത്രണ്ട് ലക്ഷം മുതൽ പതിനാറ് ലക്ഷം രൂപ വരെയുള്ള വരുമാനത്തിന് പതിനഞ്ച് ശതമാനവുമാണ് നികുതി നിരക്ക്. പതിനാറ് മുതൽ ഇരുപത് ലക്ഷം വരെ ഇരുപത് ശതമാനവും, ഇരുപത് മുതൽ ഇരുപത്തിനാല് ലക്ഷം വരെ ഇരുപത്തഞ്ച് ശതമാനവും, ഇരുപത്തിനാല് ലക്ഷത്തിന് മുകളിലുള്ള വരുമാനത്തിന് മുപ്പത് ശതമാനവും നികുതി ബാധകമാണ്. ഡീഫോൾട്ട് റെജീമിൽ മുതിർന്ന പൗരന്മാർക്ക് പ്രത്യേക ഉയർന്ന ബേസിക് എക്സംപ്ഷൻ പരിധി ലഭ്യമല്ല. ഇത്തരത്തിൽ കണ്ടെത്തുന്ന ആകെ നികുതി തുകയുടെ കൂടെ നാല് ശതമാനം ഹെൽത്ത് ആൻഡ് എഡ്യൂക്കേഷൻ സെസ്സ് കൂടി നിർബന്ധമായും ഈടാക്കേണ്ടതാണ്.", "topic_id": "default_tax_regime_slab_rates_for_indivi", "topic_title": "Default Tax Regime Slab Rates for Individuals u/s 115BAC(1A)", "audio_file": "q6.mp3"}, {"question_number": 7, "statutory_sections": ["Section 115BAC", "Section 87A"], "core_principle": "Default Tax Regime Slabs & Enhanced Rebate u/s 87A", "provision_presentation_markdown": "### **Tax Slabs u/s 115BAC (A.Y. 2026-27)**\n\n| Total Income Slab | Applicable Tax Rate |\n| :--- | :--- |\n| **Upto ₹ 4,00,000** | **Nil** |\n| **₹ 4,00,001 — ₹ 8,00,000** | **5%** |\n| **₹ 8,00,001 — ₹ 12,00,000** | **10%** |\n| **₹ 12,00,001 — ₹ 16,00,000** | **15%** |\n| **₹ 16,00,001 — ₹ 20,00,000** | **20%** |\n| **₹ 20,00,001 — ₹ 24,00,000** | **25%** |\n| **Above ₹ 24,00,000** | **30%** |\n\n---\n\n### **Rebate & Surcharge Highlights**\n* 🔹 **Section 87A Rebate (Default Regime):**\n  * **Eligibility:** Resident Individual with Total Income $\\le$ **₹ 12,00,000**.\n  * **Quantum:** Lower of **Tax Payable** or **₹ 60,000**.\n* 🔹 **Health & Education Cess:** **4%** on tax liability (after rebate u/s 87A).\n* 🔹 **Age Benefit:** No separate basic exemption for Senior/Super Senior citizens under Section 115BAC.", "malayalam_audio_script": "സെക്ഷൻ 115BAC പ്രകാരമുള്ള ഡിഫോൾട്ട് ടാക്സ് റെജീമിൽ, അസസ്സ്മെന്റ് ഇയർ 2026-27-ലേക്ക് നാല് ലക്ഷം രൂപ വരെയുള്ള വരുമാനത്തിന് നികുതി ബാധ്യതയില്ല. നാല് ലക്ഷം മുതൽ എട്ട് ലക്ഷം രൂപ വരെ അഞ്ച് ശതമാനവും, എട്ട് ലക്ഷം മുതൽ പന്ത്രണ്ട് ലക്ഷം രൂപ വരെയുള്ള വരുമാനത്തിന് പത്ത് ശതമാനവുമാണ് ടാക്സ് റേറ്റ്. ഒരു റെസിഡന്റ് ഇൻഡിവിജ്വലിന്റെ ആകെ വരുമാനം പന്ത്രണ്ട് ലക്ഷം രൂപയോ അതിൽ താഴെയോ ആണെങ്കിൽ, സെക്ഷൻ 87A പ്രകാരം പരമാവധി അറുപതിനായിരം രൂപ വരെ അല്ലെങ്കിൽ അടയ്ക്കേണ്ട നികുതി തുക, ഇതിൽ ഏതാണോ കുറവ്, അത് റിബേറ്റായി ക്ലെയിം ചെയ്യാം.", "topic_id": "default_tax_regime_slabs_enhanced_rebate", "topic_title": "Default Tax Regime Slabs & Enhanced Rebate u/s 87A", "audio_file": "q7.mp3"}, {"question_number": 8, "statutory_sections": ["Section 115BAC", "Section 87A"], "core_principle": "Marginal Relief under Section 87A in Default Tax Regime", "provision_presentation_markdown": "### 📌 Section 115BAC & Marginal Relief u/s 87A\n\n#### 1. Tax Slabs under Default Tax Regime (Section 115BAC)\n| Total Income Slab | Applicable Tax Rate |\n| :--- | :---: |\n| Upto ₹ 3,00,000 | **Nil** |\n| ₹ 3,00,001 – ₹ 7,00,000 | **5%** |\n| ₹ 7,00,001 – ₹ 10,00,000 | **10%** |\n| ₹ 10,00,001 – ₹ 12,00,000 | **15%** |\n| ₹ 12,00,001 – ₹ 15,00,000 | **20%** |\n| Above ₹ 15,00,000 | **30%** |\n\n---\n\n#### 2. Rebate & Marginal Relief Mechanism (Section 87A)\n* **Standard Rebate:** Resident individuals with total income up to the threshold limit are entitled to a rebate of 100% of income-tax payable.\n* **Marginal Relief Formula:** Where total income marginally exceeds the threshold limit, the tax payable cannot exceed the income exceeding such threshold limit:\n\n$$\\text{Rebate u/s 87A} = \\text{Tax on Total Income} - (\\text{Total Income} - \\text{Threshold Limit})$$\n\n* **Final Tax:** Tax payable before cess is restricted to $(\\text{Total Income} - \\text{Threshold Limit}) + 4\\%\\text{ Health \\& Education Cess}$.", "malayalam_audio_script": "സെക്ഷൻ 115BAC പ്രകാരമുള്ള ഡിഫോൾട്ട് ടാക്സ് റെജീമിൽ, ഒരു റസിഡന്റ് വ്യക്തിയുടെ വരുമാനം നിശ്ചിത പരിധിയിൽ അല്പം മാത്രം കവിയുകയാണെങ്കിൽ, അവർക്ക് സെക്ഷൻ 87A പ്രകാരം മാർജിനൽ റിലീഫ് ലഭിക്കും. അതായത്, കണക്കാക്കിയ ആകെ ടാക്സ്, പരിധിക്ക് മുകളിലുള്ള വരുമാനത്തേക്കാൾ കൂടുതലാണെങ്കിൽ, ആ വ്യത്യാസം സെക്ഷൻ 87A റിബേറ്റായി കുറവ് ചെയ്യാം. ഇതിലൂടെ ടാക്സ് ബാധ്യത പരിധിക്ക് മുകളിലുള്ള അധിക വരുമാനത്തിലേക്ക് മാത്രമായി പരിമിതപ്പെടുത്തുന്നു. അതിനുശേഷം 4 ശതമാനം ഹെൽത്ത് ആൻഡ് എഡ്യൂക്കേഷൻ സെസ് ചേർത്ത് അന്തിമ ടാക്സ് ലയബിലിറ്റി കണക്കാക്കുന്നു.", "topic_id": "marginal_relief_under_section_87a_in_def", "topic_title": "Marginal Relief under Section 87A in Default Tax Regime", "audio_file": "q8.mp3"}, {"question_number": 9, "statutory_sections": ["Section 4", "Annual Finance Act"], "core_principle": "Marginal Relief on Surcharge for Domestic Companies Exceeding ₹1 Crore Threshold", "provision_presentation_markdown": "### Tax Rates & Surcharge for Domestic Companies (Normal Provisions)\n\n| Turnover in P.Y. 2023-24 | Base Tax Rate |\n| :--- | :--- |\n| **≤ ₹ 400 Crore** | **25%** |\n| **> ₹ 400 Crore** | **30%** |\n\n---\n\n### Surcharge Slabs for Domestic Companies\n\n| Total Income Slab | Surcharge Rate |\n| :--- | :--- |\n| **Up to ₹ 1 Crore** | **Nil** |\n| **> ₹ 1 Crore up to ₹ 10 Crore** | **7%** |\n| **> ₹ 10 Crore** | **12%** |\n\n> **Note:** Health and Education Cess is leviable @ **4%** on (Tax + Surcharge - Marginal Relief).\n\n---\n\n### Marginal Relief Formula (Income > ₹ 1 Crore up to ₹ 10 Crore)\n\nWhere total income exceeds ₹ 1 crore, the total amount payable as tax and surcharge shall not exceed:\n\n$$\\text{Tax on ₹ 1 Crore} + (\\text{Total Income} - ₹ 1\\text{ Crore})$$\n\n$$\\text{Marginal Relief} = (\\text{Tax} + \\text{Surcharge}) - [\\text{Tax on ₹ 1 Crore} + (\\text{Total Income} - ₹ 1,00,00,000)]$$", "malayalam_audio_script": "ഒരു ഡൊമസ്റ്റിക് കമ്പനിയുടെ മുൻവർഷത്തെ ടേണോവർ 400 കോടി രൂപയിൽ കൂടുതലാണെങ്കിൽ, ബാധകമായ നോർമൽ ടാക്സ് റേറ്റ് 30 ശതമാനമാണ്. ടോട്ടൽ ഇൻകം ഒരു കോടി രൂപ കവിയുമ്പോൾ 7 ശതമാനം സർചാർജ്ജ് ബാധകമാകും. എന്നാൽ, ഒരു കോടി രൂപയ്ക്ക് മുകളിൽ അധികമായി വന്ന വരുമാനത്തേക്കാൾ കൂടുതലായി ടാക്സും സർചാർജ്ജും വർദ്ധിക്കാൻ പാടില്ല. അത്തരം സന്ദർഭങ്ങളിൽ മാർജിനൽ റിലീഫ് ലഭ്യമാണ്. അതായത്, സർചാർജ്ജ് ഉൾപ്പെടെയുള്ള ആകെ ടാക്സ് തുക, ഒരു കോടി രൂപയ്ക്കുള്ള ടാക്സും ഒരു കോടിക്ക് മുകളിലുള്ള അധിക വരുമാനവും കൂട്ടിയ തുകയെക്കാൾ കൂടരുത്. ഈ രണ്ട് തുകകൾ തമ്മിലുള്ള വ്യത്യാസമാണ് മാർജിനൽ റിലീഫായി അനുവദിക്കുന്നത്.", "topic_id": "marginal_relief_on_surcharge_for_domesti", "topic_title": "Marginal Relief on Surcharge for Domestic Companies Exceeding ₹1 Crore Threshold", "audio_file": "q9.mp3"}, {"question_number": 10, "statutory_sections": ["Section 4", "Finance Act"], "core_principle": "Marginal Relief on Surcharge for Domestic Companies exceeding ₹ 10 Crore", "provision_presentation_markdown": "### **1. Tax Rates for Domestic Companies (Regular Regime)**\n\n| Total Turnover / Gross Receipts (P.Y. 2023-24) | Base Tax Rate |\n| :--- | :---: |\n| $\\le$ ₹ 400 Crore | **25%** |\n| Exceeding ₹ 400 Crore | **30%** |\n\n---\n\n### **2. Surcharge Rates for Domestic Companies**\n\n| Total Income Slab | Surcharge Rate |\n| :--- | :---: |\n| **Up to ₹ 1 Crore** | Nil |\n| **> ₹ 1 Crore but $\\le$ ₹ 10 Crore** | **7%** |\n| **> ₹ 10 Crore** | **12%** |\n\n* **Health & Education Cess:** 4% applicable on (Tax + Surcharge - Marginal Relief).\n\n---\n\n### **3. Marginal Relief Computation Steps (> ₹ 10 Crore)**\n\n1. **Step 1:** Compute Tax + Surcharge @ 12% on Total Income.\n2. **Step 2:** Compute Tax + Surcharge @ 7% on threshold limit of ₹ 10 Crore.\n3. **Step 3:** Calculate Maximum Tax Payable:\n   $$\\text{Capped Tax} = (\\text{Tax on ₹ 10 Cr}) + (\\text{Total Income} - ₹ 10\\text{ Cr})$$\n4. **Step 4:** **Marginal Relief** = $\\text{Step 1 Tax} - \\text{Step 3 Capped Tax}$.", "malayalam_audio_script": "ഒരു ഡൊമസ്റ്റിക് കമ്പനിയുടെ മുൻവർഷത്തെ ടേൺഓവർ 400 കോടി രൂപയിൽ കൂടുതലാണെങ്കിൽ സാധാരണ നികുതി നിരക്ക് 30 ശതമാനമാണ്. മൊത്തം വരുമാനം ഒരു കോടി മുതൽ 10 കോടി രൂപ വരെയാണെങ്കിൽ 7 ശതമാനവും, 10 കോടി രൂപയ്ക്ക് മുകളിലാണെങ്കിൽ 12 ശതമാനവുമാണ് സർചാർജ്. വരുമാനം 10 കോടി രൂപയ്ക്ക് തൊട്ടുമുകളിൽ എത്തുമ്പോൾ, സർചാർജ് നിരക്ക് പെട്ടെന്ന് ഉയരുന്നതുമൂലം ഉണ്ടാകുന്ന അധിക നികുതി, വരുമാനത്തിൽ ഉണ്ടായ വർദ്ധനവിനേക്കാൾ കൂടാൻ പാടില്ല. ഇതിനായി മാർജിനൽ റിലീഫ് അനുവദിക്കുന്നു. അതായത്, മൊത്തം വരുമാനത്തിൻ്റെ ടാക്സും സർചാർജും, 10 കോടി രൂപ വരെയുള്ള വരുമാനത്തിന് നൽകേണ്ട ടാക്സിനേക്കാളും, 10 കോടിക്ക് മുകളിലുള്ള അധിക വരുമാനത്തേക്കാളും കൂടരുത്. ഇവ തമ്മിലുള്ള വ്യത്യാസമാണ് മാർജിനൽ റിലീഫായി കുറവ് ചെയ്യുന്നത്.", "topic_id": "marginal_relief_on_surcharge_for_domesti", "topic_title": "Marginal Relief on Surcharge for Domestic Companies exceeding ₹ 10 Crore", "audio_file": "q9.mp3"}]}
</script>
<script>
function buildModelFromPipeline(data) {
  const dtChapters = (data?.catalog?.chapters || []).map(c => {
    const pr = c.page_range || (c.chapter_number + ".1 - " + c.chapter_number + ".20");
    const parts = pr.includes("-") ? pr.split("-") : [pr, pr];
    return [c.chapter_number, c.title, parts[0].trim(), parts[1].trim()];
  });

  const realQna = (data?.questions || []).map(q => {
    const p = (data?.provisions || []).find(x => x.question_number === q.question_number);
    const topicId = p?.topic_id || ("T_Q" + q.question_number);
    return {
      id: "dt-1-" + q.question_number,
      sub: "dt",
      ch: 1,
      n: q.question_number,
      title: q.question_title,
      topic: topicId,
      secs: p?.statutory_sections || ["Section 4"],
      q: [q.question_text],
      rawAnswer: q.answer_text
    };
  });

  const provMap = {};
  (data?.provisions || []).forEach(p => {
    const tid = p.topic_id || ("T_Q" + p.question_number);
    if (!provMap[tid]) {
      provMap[tid] = {
        doctrine: p.topic_title || p.core_principle || ("Topic " + tid),
        principle: p.core_principle || p.topic_title || "",
        secs: p.statutory_sections || [],
        rawMarkdown: p.provision_presentation_markdown || "",
        dur: p.dur || p.duration_seconds || 60,
        voice: p.voice_engine || "Gemini Voice (Aoede)",
        file: p.audio_file || ("q" + p.question_number + ".mp3"),
        video: p.video_file || ("q" + p.question_number + ".mp4"),
        ml: p.malayalam_audio_script || ""
      };
    }
  });

  return {
    catalog: {
      dt: { name: "Direct Tax", code: "DT", chapters: dtChapters },
      idt: { name: "Indirect Tax", code: "IDT", chapters: [] }
    },
    qna: realQna,
    prov: provMap,
    storyboards: data?.storyboards || {},
    mindmaps: data?.mindmaps || {}
  };
}

window.D = {
  catalog: { dt: { name: "Direct Tax", code: "DT", chapters: [] }, idt: { name: "Indirect Tax", code: "IDT", chapters: [] } },
  qna: [],
  prov: {},
  storyboards: {},
  mindmaps: {}
};

try {
  const el = document.getElementById("pipeline-data");
  if (el && el.textContent) {
    const raw = JSON.parse(el.textContent);
    window.D = buildModelFromPipeline(raw);
  }
} catch (e) {
  console.error("Error parsing embedded pipeline data:", e);
}

async function fetchPipelineUpdate() {
  try {
    const res = await fetch("/api/data");
    if (res.ok) {
      const live = await res.json();
      if (live && live.catalog) {
        window.D = buildModelFromPipeline(live);
        if (typeof render === "function") render();
      }
    }
  } catch(e) {}
}
fetchPipelineUpdate();
/* ---------- helpers ---------- */
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
const REDUCED=matchMedia("(prefers-reduced-motion: reduce)").matches;
const I={
 arrow:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
 chev:'<svg class="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>',
 back:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>',
 search:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>',
 play:'<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>',
 pause:'<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4.5" height="14" rx="1.2"/><rect x="13.5" y="5" width="4.5" height="14" rx="1.2"/></svg>',
 down:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>',
 check:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
 eq:'<span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>',
 spk:'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4zM16 9a4 4 0 0 1 0 6"/></svg>'
};
const fmt=s=>{s=Math.max(0,Math.round(s));return Math.floor(s/60)+":"+String(s%60).padStart(2,"0")};
const toastEl=$("#toast");let toastT;
function toast(m){toastEl.textContent=m;toastEl.classList.add("show");clearTimeout(toastT);toastT=setTimeout(()=>toastEl.classList.remove("show"),2600)}

/* ---------- data access ---------- */
const subj=k=>D.catalog[k];
const qs=(sub,ch)=>D.qna.filter(q=>q.sub===sub&&q.ch===ch).sort((a,b)=>a.n-b.n);
const chapters=sub=>(subj(sub)?.chapters||[]).map(([n,title,f,t])=>({n,title,f,t,count:qs(sub,n).length}));
const isOriginal=(q,list)=>list.find(x=>x.topic===q.topic)===q;
const preview=q=>{const t=q.q[0]||"";return t.length>150?t.slice(0,147).replace(/\s+\S*$/,"")+"…":t};
const secTags=q=>(q.secs||[]).map(s=>`<span class="sec">${esc(s)}</span>`).join("");
const hl=(text,term)=>{const e=esc(text);if(!term)return e;const r=new RegExp("("+term.replace(/[.*+?^${}()|[\]\\]/g,"\\$&").replace(/&/g,"&amp;")+")","ig");return e.replace(r,"<mark>$1</mark>")};

/* ---------- ambient symbols ---------- */
(function(){const host=$("#ambient");if(REDUCED)return;
 const t=["§ 115BAC","Sec 4","₹","87A","Sec 10(10)","GST","§ 3","Rule 8","4%","CGST § 8","15/26","Sec 2(24)","AY 2026-27","§ 2(30)"];
 t.forEach((s,i)=>{const e=document.createElement("span");e.className="sym";e.textContent=s;
  e.style.cssText=`left:${(i*37+8)%94}%;top:${100+((i*23)%40)}vh;font-size:${14+(i%4)*6}px;animation-duration:${60+(i%5)*14}s;animation-delay:-${(i*9)%60}s`;host.appendChild(e)})})();

/* ===== Motion layer helpers ===== */
const splitWords=t=>t.split(" ").map((w,i)=>`<span class="wm"><span class="w${w==="section"?" g":""}" style="--i:${i}">${w}</span></span>`).join(" ");
const att=q=>store.get("commit:"+q.id)?`<span class="att">${I.check}Attempted</span>`:"";
const marquee=()=>{const u=[...new Set([...Object.values(D.prov).flatMap(p=>p.secs||[]),"AY 2026-27","Sec 2(24)","Sec 4","Sec 5","Sec 115BAC"])];
 const row=u.map(s=>`<span class="sec">${esc(s)}</span>`).join("");return `<div class="marquee" aria-hidden="true"><div class="mq-track">${row}${row}</div></div>`};
const ringHtml=(sub,n)=>{const l=qs(sub,n),d=l.filter(q=>store.get("commit:"+q.id)).length,off=(100.5*(1-d/Math.max(1,l.length))).toFixed(1);
 return `<span class="ring" title="${d} of ${l.length} answers committed"><svg viewBox="0 0 40 40" width="42" height="42" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="none" stroke="var(--line)" stroke-width="3.5"/><circle class="rp" data-off="${off}" cx="20" cy="20" r="16" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="100.5" style="stroke-dashoffset:100.5"/></svg><b>${d}/${l.length}</b></span>`};
const animRings=()=>$$(".rp").forEach(c=>{c.style.strokeDashoffset=c.dataset.off});
const art=k=>k==="dt"
 ?`<svg class="art" viewBox="0 0 160 120" aria-hidden="true">${[14,26,40,56,72,90,108].map((h,i)=>`<rect class="bar" style="--d:${i}" x="${6+i*22}" y="${114-h}" width="16" height="${h}" rx="4" fill="currentColor" fill-opacity="${(.25+i*.11).toFixed(2)}"/>`).join("")}<path class="trend" d="M14 100 L36 88 L58 74 L80 58 L102 42 L124 24 L146 6" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round"/></svg>`
 :`<svg class="art" viewBox="0 0 160 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-opacity=".35" stroke-dasharray="3 5"><circle cx="80" cy="60" r="22"/><circle cx="80" cy="60" r="38"/><circle cx="80" cy="60" r="54"/></g><circle cx="80" cy="60" r="9" fill="currentColor"/>${[[22,7,0],[38,11,1],[54,16,2]].map(([r,s,i])=>`<g class="orbit" style="transform-origin:80px 60px;animation-duration:${s}s;animation-delay:-${i*2}s"><circle cx="${80+r}" cy="60" r="${(5-i*.6).toFixed(1)}" fill="currentColor"/></g>`).join("")}</svg>`;

function burst(el){if(REDUCED)return;const b=el.getBoundingClientRect(),cx=b.left+b.width/2,cy=b.top+b.height/2;
 const cv=document.createElement("canvas"),d=Math.min(2,devicePixelRatio||1);cv.style.cssText="position:fixed;inset:0;width:100%;height:100%;z-index:90;pointer-events:none";
 cv.width=innerWidth*d;cv.height=innerHeight*d;document.body.appendChild(cv);const x=cv.getContext("2d");x.scale(d,d);
 const cs=getComputedStyle(document.body),cols=["--accent","--brass","--ok","--idt","--dt"].map(v=>cs.getPropertyValue(v).trim());
 const P=Array.from({length:90},()=>{const a=Math.random()*Math.PI*2,s=4+Math.random()*9;return{x:cx,y:cy,vx:Math.cos(a)*s,vy:Math.sin(a)*s-5,w:5+Math.random()*6,h:3+Math.random()*4,r:Math.random()*6,vr:(Math.random()-.5)*.4,c:cols[Math.floor(Math.random()*cols.length)]}});
 const t0=performance.now();(function f(n){const t=(n-t0)/1400;x.clearRect(0,0,innerWidth,innerHeight);
  P.forEach(p=>{p.vy+=.28;p.vx*=.985;p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;x.save();x.globalAlpha=Math.max(0,1-t);x.translate(p.x,p.y);x.rotate(p.r);x.fillStyle=p.c;x.fillRect(-p.w/2,-p.h/2,p.w,p.h);x.restore()});
  if(t<1)requestAnimationFrame(f);else cv.remove()})(t0)}

/* ---------- routing ---------- */
const app=$("#app");let player=null,io=null,lastDepth=0;
function parse(){const h=location.hash.replace("#","");if(!h)return{v:"home"};
 const p=h.split("-");if(!["dt","idt"].includes(p[0]))return{v:"home"};
 const r={sub:p[0],v:"chapters"};let m;
 if(p[1]&&(m=p[1].match(/^c(\d+)$/))){r.ch=+m[1];r.v="questions";
  if(p[2]&&(m=p[2].match(/^q(\d+)$/))){r.n=+m[1];r.v="studio"}}
 return r}
const go=h=>{location.hash=h};
const depthOf=r=>({home:0,chapters:1,questions:2,studio:3})[r.v];

function renderMath(el = document.getElementById("app")){
 if(!el) return;
 if(typeof renderMathInElement === "function"){
  try {
   renderMathInElement(el, {
    delimiters: [
     {left: "$$", right: "$$", display: true},
     {left: "$", right: "$", display: false},
     {left: "\\[", right: "\\]", display: true},
     {left: "\\(", right: "\\)", display: false}
    ],
    throwOnError: false
   });
  } catch(e){
   console.warn("KaTeX render error:", e);
  }
 }
}

function cleanup(){
  if(player){player.destroy();player=null}
  if(io){io.disconnect();io=null}
  const troot = $("#theater-root");
  if(troot) troot.innerHTML = "";
  document.body.style.overflow = "";
}
function mount(html,r){cleanup();const d=depthOf(r);const back=d<lastDepth;lastDepth=d;
 app.innerHTML=`<div class="view${back?" back":""}">${html}</div>`;
 document.body.dataset.sub=r.sub||"";document.body.dataset.view=r.v;window.scrollTo({top:0,behavior:"auto"});
 setCrumbs(r);
 requestAnimationFrame(()=>renderMath(app));
}
function setCrumbs(r){const c=[];
 if(r.sub){c.push(`<span class="sep">/</span><span>${subj(r.sub)?.name||r.sub}</span>`)}
 if(r.ch){c.push(`<span class="sep">/</span><span>Ch ${r.ch}</span>`)}
 if(r.n){c.push(`<span class="sep">/</span><span>Q${r.n}</span>`)}
 $("#crumbs").innerHTML=c.join("")}
function render(){const r=parse();({home:vHome,chapters:vChapters,questions:vQuestions,studio:vStudio})[r.v](r)}
addEventListener("hashchange",render);

/* ---------- Window 1 ---------- */
function vHome(r){
 const dtChapters = chapters("dt");
 const dtReady = D.qna.filter(q=>q.sub==="dt").length;
 const dtTopics = new Set(D.qna.filter(q=>q.sub==="dt").map(q=>q.topic)).size;

 const doorDt = `<button class="door dt rise" style="--i:2" data-go="dt">
   ${art("dt")}<div class="mark">DT<small>Income-tax Act</small></div>
   <div><h2>Direct Tax</h2><p style="margin-top:8px">Extracted from AIR1 DT Question Bank. 25 cataloged chapters with 10 questions ready in Chapter 1.</p></div>
   <div class="stats"><div><b data-count="${dtChapters.length}">0</b><span>chapters</span></div><div><b data-count="${dtReady}">0</b><span>questions ready</span></div><div><b data-count="${dtTopics}">0</b><span>audio topics</span></div></div>
   <span class="go" aria-hidden="true">${I.arrow}</span></button>`;

 const doorIdt = `<button class="door idt rise" style="--i:3" data-go="idt" style="opacity:0.92">
   ${art("idt")}<div class="mark">IDT<small>Phase 2</small></div>
   <div><h2>Indirect Tax</h2><p style="margin-top:8px">Pending Question Bank upload. Upload Indirect Tax PDF in Developer Portal to parse chapters and questions.</p></div>
   <div class="stats"><div><b>0</b><span>chapters</span></div><div><b>0</b><span>questions</span></div><div><span class="pill idle" style="margin-top:6px"><i class="dot"></i>Upload Pending</span></div></div>
   <span class="go" aria-hidden="true">${I.arrow}</span></button>`;

 mount(`<section class="hero"><div class="eyebrow rise">ICAI CA Final · Spoken Malayalam Audio Coaching</div>
  <h1 class="split" aria-label="Learn the section before you solve the question.">${splitWords("Learn the section before you solve the question.")}</h1>
  <p class="rise" style="--i:2">Direct Tax questions and statutory doctrines extracted directly from the question bank. Spoken Malayalam audio explains each doctrine once and is shared across case studies.</p></section>
  <div class="doors">${doorDt}${doorIdt}</div>
  ${marquee()}<div class="flow-note rise" style="--i:5"><span class="step"><b>1</b>Subject</span>${I.arrow.replace('width="22" height="22"','width="14" height="14"')}<span class="step"><b>2</b>Chapter</span>${I.arrow.replace('width="22" height="22"','width="14" height="14"')}<span class="step"><b>3</b>Question</span>${I.arrow.replace('width="22" height="22"','width="14" height="14"')}<span class="step"><b>4</b>Study Studio</span></div>
  <p class="foot rise" style="--i:6">Live content is strictly loaded from AIR1 DT Question Bank.pdf with 25 cataloged chapters and 10 questions. IDT will activate as soon as an IDT PDF is uploaded in the Developer Portal.</p>`,r);
 $$("[data-count]").forEach(el=>{const to=+el.dataset.count;if(REDUCED){el.textContent=to;return}
  const t0=performance.now();(function f(n){const p=Math.min(1,(n-t0)/1100);el.textContent=Math.round(to*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(f)})(t0)})}
app.addEventListener("pointermove",e=>{const d=e.target.closest(".door");if(!d)return;const b=d.getBoundingClientRect();d.style.setProperty("--mx",e.clientX-b.left+"px");d.style.setProperty("--my",e.clientY-b.top+"px")});

/* ---------- Window 2 ---------- */
let chState={q:"",f:"all"};
function vChapters(r){
 chState={q:"",f:"all"};const s=subj(r.sub),list=chapters(r.sub),ready=list.filter(c=>c.count).length;

 if(!list.length){
  mount(`<button class="back-btn rise" data-go="">${I.back}All subjects</button>
   <div class="head"><div class="eyebrow rise" style="--i:1">Indirect Tax · Phase 2 Pipeline</div>
   <h1 class="rise" style="--i:2"><span>${s.name}</span> Syllabus</h1></div>
   <div class="empty rise" style="padding:48px 24px;max-width:580px;margin:32px auto;background:var(--surface);border:1px dashed var(--line);border-radius:20px;text-align:center">
     <div style="font-size:2.8rem;margin-bottom:14px">📂</div>
     <b style="font-size:1.35rem;display:block;margin-bottom:10px">No Indirect Tax Question Bank Uploaded Yet</b>
     <p style="margin-bottom:24px;color:var(--ink-2);line-height:1.6">The pipeline has cataloged 25 chapters and extracted 10 questions for <b>Direct Tax</b> from <code>AIR1 DT Question Bank.pdf</code>.<br>To extract and view Indirect Tax chapters, upload the IDT Question Bank PDF in the Developer Portal.</p>
     <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
       <button class="primary" data-go="dt">Open Direct Tax (25 Chapters)</button>
       <a href="http://localhost:8501" target="_blank" class="nav-btn" style="text-decoration:none;padding:12px 20px">Open Dev Portal</a>
     </div>
   </div>`,r);
  return;
 }

 mount(`<button class="back-btn rise" data-go="">${I.back}All subjects</button>
  <div class="head"><div class="eyebrow rise" style="--i:1">${s.code} syllabus · ${list.length} chapters · ${ready} with questions</div>
  <h1 class="rise" style="--i:2"><span>${s.name}</span> chapters</h1></div>
  <div class="tools rise" style="--i:3"><label class="search" for="chsearch">${I.search}<input id="chsearch" type="search" placeholder="Filter chapters by number or keyword" autocomplete="off"></label>
   <div class="chips" role="group" aria-label="Filter by readiness"><button class="chip" data-f="all" aria-pressed="true">All</button><button class="chip" data-f="ready" aria-pressed="false">Questions ready</button><button class="chip" data-f="soon" aria-pressed="false">Coming soon</button></div></div>
  <div class="list" id="chlist"></div>`,r);
 drawChapters(r)}
function drawChapters(r){requestAnimationFrame(()=>requestAnimationFrame(animRings));
 const t=chState.q.trim().toLowerCase();
 const rows=chapters(r.sub).filter(c=>(chState.f==="all"||(chState.f==="ready"?c.count>0:c.count===0))&&(!t||`ch ${c.n} chapter ${c.n} ${c.title}`.toLowerCase().includes(t)));
 $("#chlist").innerHTML=rows.length?rows.map((c,i)=>`<button class="row rise" style="--i:${Math.min(i,10)}" data-go="${r.sub}-c${c.n}">
  <div class="num">${String(c.n).padStart(2,"0")}</div>
  <div><h3>${hl(c.title,chState.q.trim())}</h3><div class="meta"><span>Ch ${c.n}</span><span class="mono">pp. ${c.f} to ${c.t}</span></div></div>
  <span class="rt">${c.count?ringHtml(r.sub,c.n)+`<span class="pill ok"><i class="dot"></i>${c.count} Question${c.count>1?"s":""} Ready</span>`:`<span class="pill idle">Questions coming soon</span>`}</span>${I.chev}</button>`).join("")
  :`<div class="empty rise"><b>No chapter matches "${esc(chState.q)}"</b>Try a chapter number or a word from the title, such as "tax" or "income".</div>`}
app.addEventListener("input",e=>{if(e.target.id==="chsearch"){chState.q=e.target.value;drawChapters(parse())}});

/* ---------- Window 3 ---------- */
function vQuestions(r){
 const s=subj(r.sub),c=chapters(r.sub).find(x=>x.n===r.ch);
 if(!c){go(r.sub);return}
 const mode=store.get("tsMode")==="topic"?"topic":"seq";
 mount(`<button class="back-btn rise" data-go="${r.sub}">${I.back}Chapters</button>
  <div class="chmeta"><div><div class="eyebrow rise" style="--i:1">${s.name} · <b>Chapter ${c.n}</b> · pp. ${c.f} to ${c.t}</div><h1 class="rise" style="--i:2;margin-top:10px">${esc(c.title)}</h1></div>
  ${c.count?`<div class="seg rise" style="--i:3" id="seg" data-mode="${mode}"><span class="thumb"></span><button data-mode="seq" aria-pressed="${mode==="seq"}">Sort by Question</button><button data-mode="topic" aria-pressed="${mode==="topic"}">Group by Topic</button></div>`:""}</div>
  <div id="qlist"></div>`,r);
 drawQuestions(r,mode)}
function qRow(q,r,list,showAudio,i){
 return `<button class="q rise" style="--i:${Math.min(i,10)}" data-go="${r.sub}-c${r.ch}-q${q.n}"><div class="qn">Q${q.n}</div>
  <div><h3>${esc(q.title)}</h3><p class="pv">${esc(preview(q))}</p>
  <div class="tags">${secTags(q)}${att(q)}${showAudio?(isOriginal(q,list)?`<span class="audio-tag orig">${I.eq}Original topic audio</span>`:`<span class="audio-tag">${I.spk}Shared topic audio</span>`):""}</div></div>${I.chev}</button>`}
function drawQuestions(r,mode){
 const list=qs(r.sub,r.ch),host=$("#qlist");
 if(!list.length){host.innerHTML=`<div class="empty rise"><b>Questions for this chapter are being added</b>The chapter is mapped in the syllabus catalog. It opens here once its questions and provisions are in the data files.</div>`;return}
 if(mode==="seq"){host.innerHTML=`<div class="list">${list.map((q,i)=>qRow(q,r,list,true,i)).join("")}</div>`;return}
 const topics=[...new Set(list.map(q=>q.topic))];
 host.innerHTML=topics.map((tp,i)=>{const p=D.prov[tp]||{doctrine:tp,secs:[],dur:60},items=list.filter(q=>q.topic===tp);
  return `<section class="cluster rise" style="--i:${i}"><header><div><div class="kicker">Cluster ${i+1}</div><h2>${esc(p.doctrine)}</h2>
   <div style="display:flex;flex-wrap:wrap;gap:8px">${(p.secs||[]).map(x=>`<span class="sec">${esc(x)}</span>`).join("")}</div></div>
   <span class="audio-tag orig">${I.eq}Shared canonical audio · ${fmt(p.dur||60)}</span></header>
   <div class="sub">${items.map((q,j)=>qRow(q,r,list,false,j)).join("")}</div></section>`}).join("")}
app.addEventListener("click",e=>{const b=e.target.closest("#seg button");if(!b)return;
 const mode=b.dataset.mode;store.set("tsMode",mode);const seg=$("#seg");seg.dataset.mode=mode;
 $$("button",seg).forEach(x=>x.setAttribute("aria-pressed",x===b));drawQuestions(parse(),mode)});

/* ---------- Window 4 ---------- */
function tbl(t){if(!t)return"";const num=c=>t.r.every(r=>!r[c]||/^[\d,]+(\.\d+)?%?$/.test(r[c]));
 return `<div class="tbl-wrap"><table><thead><tr>${t.h.map((h,c)=>`<th class="${num(c)?"n":""}">${esc(h)}</th>`).join("")}</tr></thead><tbody>${t.r.map((r,i)=>`<tr class="${t.tot&&i===t.r.length-1?"total":""}">${r.map((x,c)=>`<td class="${num(c)?"n":""}">${esc(x)}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`}
const stageHead = (n, t) => `<div class="stage-h"><span class="no">STAGE ${n} OF 4</span><h2>${t}</h2></div>`;

function renderProvMarkdown(rawMd, doctrine){
 if(!rawMd) return "";
 let cleaned = rawMd.trim();
 const lines = cleaned.split("\n");
 if(lines[0] && /^#{1,4}\s+/.test(lines[0])){
  lines.shift();
  while(lines.length && !lines[0].trim()) lines.shift();
  cleaned = lines.join("\n");
 }
 if(window.katex){
  cleaned = cleaned.replace(/\$\$([\s\S]+?)\$\$/g, (m, tex) => {
   try { return katex.renderToString(tex.trim(), { displayMode: true, throwOnError: false }); } catch(e) { return m; }
  });
  cleaned = cleaned.replace(/\$([^\$\n]+?)\$/g, (m, tex) => {
   try { return katex.renderToString(tex.trim(), { displayMode: false, throwOnError: false }); } catch(e) { return m; }
  });
 }
 const html = marked.parse(cleaned);
 return html.replace(/<table>/g, '<div class="tbl-wrap"><table>').replace(/<\/table>/g, '</table></div>');
}

function renderAnswerMarkdown(rawAnswer){
 if(!rawAnswer) return "";
 let cleaned = rawAnswer.trim();
 if(window.katex){
  cleaned = cleaned.replace(/\$\$([\s\S]+?)\$\$/g, (m, tex) => {
   try { return katex.renderToString(tex.trim(), { displayMode: true, throwOnError: false }); } catch(e) { return m; }
  });
  cleaned = cleaned.replace(/\$([^\$\n]+?)\$/g, (m, tex) => {
   try { return katex.renderToString(tex.trim(), { displayMode: false, throwOnError: false }); } catch(e) { return m; }
  });
 }
 const html = marked.parse(cleaned);
 return html.replace(/<table>/g, '<div class="tbl-wrap"><table>').replace(/<\/table>/g, '</table></div>');
}
function renderFlowchartHtml(q, p){
  const qn = q.n;
  const sbKey = 'q' + qn;
  const sb = (D.storyboards && (D.storyboards[sbKey] || D.storyboards[p.file ? p.file.replace('.mp3', '') : '']));

  if (sb && sb.slides && sb.slides.length > 0) {
    return `
      <!-- Slide Viewport: ONLY ONE SLIDE DISPLAYED AT A TIME WITH MORPH TRANSITIONS -->
      ${sb.slides.map((s, idx) => {
        const cardsCount = (s.cards || []).length;
        const cardsClass = cardsCount > 0 ? ('cards-' + cardsCount) : '';
        return `
        <div class="ppt-slide ${idx === 0 ? 'active' : ''}" data-t0="${s.t0 || 0}" data-t1="${s.t1 || 999}" data-slide-idx="${idx}" id="slide-${qn}-${s.slide_number}">
          <div class="ppt-slide-header">
            <div class="ppt-slide-badges">
              <span class="ppt-badge-slide">SLIDE ${s.slide_number} OF ${sb.slides.length}</span>
              ${s.section_badge ? `<span class="ppt-badge-sec">${esc(s.section_badge)}</span>` : ''}
            </div>
            <span class="ppt-badge-live"><span class="ppt-live-dot"></span>EXPLAINING IN MALAYALAM</span>
          </div>

          <div class="ppt-slide-title-wrap">
            <span class="ppt-title-bar"></span>
            <h2 class="ppt-slide-title">${esc(s.slide_title)}</h2>
          </div>

          <div class="ppt-cards-grid ${cardsClass}">
            ${(s.cards || []).map((c, ci) => `
              <div class="ppt-card ${c.is_highlight ? 'highlight' : ''}" style="--ci:${ci}">
                <div class="ppt-card-top">
                  ${c.badge ? `<span class="ppt-card-badge">${esc(c.badge)}</span>` : '<span></span>'}
                </div>
                <div class="ppt-card-heading">${esc(c.title)}</div>
                <ul class="ppt-card-bullets">
                  ${(c.bullets || []).map(b => `<li class="ppt-bullet"><span class="ppt-bullet-dot"></span><span>${esc(b)}</span></li>`).join('')}
                </ul>
              </div>
            `).join('')}
          </div>

          ${s.formula_box ? `
            <div class="ppt-formula-box">
              <div class="ppt-formula-tag">🧮 STATUTORY COMPUTATIONAL FORMULA</div>
              <div class="ppt-formula-text">${esc(s.formula_box.formula_text || '')}</div>
              ${s.formula_box.example_calc ? `<div class="ppt-formula-example"><span class="pfe-tag">WORKED EXAMPLE</span>${esc(s.formula_box.example_calc)}</div>` : ''}
            </div>
          ` : ''}

          ${s.malayalam_narration ? `
            <div class="ppt-narration-box">
              <div class="ppt-narration-header">
                <div class="ppt-narration-title">
                  <span class="pnb-icon">🎙️</span>
                  <span class="pnb-label">VOICE EXPLANATION (MALAYALAM)</span>
                  <span class="pnb-status"><span class="pnb-live-dot"></span>NARRATION TRANSCRIPT</span>
                </div>
                ${s.duration ? `<span class="pnb-dur">${s.duration}s</span>` : ''}
              </div>
              <p class="ppt-narration-text">${esc(s.malayalam_narration)}</p>
            </div>
          ` : ''}
        </div>
      `}).join('')}`;
  }

  if(qn === 9 || qn === 10){
    return `
    <div class="ppt-slide active" data-t0="0" data-t1="999" id="slide-${qn}-1">
      <div class="flow-grid" style="grid-template-columns:1fr 1fr;gap:18px">
        <div class="flow-node" data-t0="0" data-t1="7.5" id="fn-q9-1">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
            <span class="flow-badge blue">Step 1 · Base Tax Rate</span>
            <span class="flow-active-badge">● EXPLAINING NOW</span>
          </div>
          <div class="flow-title">Domestic Co. Turnover ≤ ₹ 400 Cr</div>
          <div class="flow-desc">Tax rate is <b>25%</b> if turnover in previous year ≤ ₹ 400 Cr. Otherwise standard rate of <b>30%</b> applies.</div>
        </div>
        <div class="flow-node" data-t0="7.5" data-t1="16.0" id="fn-q9-2">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
            <span class="flow-badge gold">Step 2 · Surcharge Slabs</span>
            <span class="flow-active-badge">● EXPLAINING NOW</span>
          </div>
          <div class="flow-title">Total Income > ₹ 1 Cr vs > ₹ 10 Cr</div>
          <div class="flow-desc">Surcharge is <b>7%</b> if TI > ₹ 1 Cr up to ₹ 10 Cr. Surcharge increases to <b>12%</b> if Total Income exceeds ₹ 10 Crores.</div>
        </div>
      </div>
    </div>`;
  }

  return `
  <div class="ppt-slide active" data-t0="0" data-t1="999" id="slide-${qn}-1">
    <div class="ppt-slide-title-wrap">
      <span class="ppt-title-bar"></span>
      <h2 class="ppt-slide-title">${esc(p.doctrine)}</h2>
    </div>
    <div class="ppt-cards-grid cards-1">
      <div class="ppt-card highlight">
        <div class="ppt-card-heading">Statutory Rule Principle</div>
        <p style="color:#334155;line-height:1.6;font-size:1.05rem">${esc(p.principle || "Detailed provision explainer audio playing in spoken Malayalam.")}</p>
      </div>
    </div>
  </div>`;
}

function getMindMapForQuestion(q, p){
  if (!window.D || !window.D.mindmaps) return null;
  const qn = String(q ? q.n : '');
  const mmKey = (window.D.mindmaps.question_to_mindmap && window.D.mindmaps.question_to_mindmap[qn]) || ('q' + qn);
  return window.D.mindmaps[mmKey] || null;
}

function getIconSvg(name, size = 20, color = "currentColor", strokeWidth = 2){
  const s = size;
  const c = color;
  const sw = strokeWidth;
  const icons = {
    scales: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h18"/></svg>`,
    shield: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    calculator: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>`,
    percent: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>`,
    cap: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 3 3 6 3s6-1 6-3v-5"/></svg>`,
    warning: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
    gear: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
    check: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
    user: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    building: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="22" x2="9" y2="18"/><line x1="15" y1="22" x2="15" y2="18"/><line x1="9" y1="6" x2="15" y2="6"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="15" y2="14"/></svg>`,
    rupee: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12M6 8h12M6 13l7.5 8M6 8a4.5 4.5 0 0 0 8 0"/></svg>`,
    arrow_right: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,
    arrow_down: `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>`
  };
  return icons[name] || icons.gear;
}

function highlightKeywords(text, hl){
  if(!text) return "";
  let clean = esc(String(text));
  if(!hl) return clean;

  const matches = [];
  const addTokens = (arr, cls) => {
    (arr || []).forEach(raw => {
      if(!raw) return;
      const s = esc(String(raw).trim());
      if(s && s.length >= 2){
        matches.push({ s, cls });
      }
    });
  };
  addTokens(hl.sections, "chip-sec");
  addTokens(hl.rates, "chip-rate");
  addTokens(hl.amounts, "chip-amt");

  if(matches.length === 0) return clean;
  matches.sort((a, b) => b.s.length - a.s.length);

  matches.forEach(({ s, cls }) => {
    const escaped = s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp(`(?<!<[^>]*)(${escaped})(?![^<]*>)`, 'g');
    clean = clean.replace(re, `<span class="${cls}">$1</span>`);
  });

  return clean;
}

function renderCardBodyContent(pt){
  let out = '';
  if (pt.trap_data) {
    out += `
      <div class="mm-trap-panel">
        <div class="mm-trap-row wrong">
          <span class="mm-trap-badge wrong">⚠️ COMMON MISTAKE</span>
          <span class="mm-trap-text">${highlightKeywords(pt.trap_data.mistake, pt.highlights)}</span>
        </div>
        <div class="mm-trap-row correct">
          <span class="mm-trap-badge correct">✓ STATUTORY RULE</span>
          <span class="mm-trap-text">${highlightKeywords(pt.trap_data.statutory_rule, pt.highlights)}</span>
        </div>
      </div>
    `;
  } else if (pt.table_data && pt.table_data.headers && pt.table_data.rows) {
    out += `
      <div class="mm-table-panel">
        ${pt.table_data.title ? `<div class="mm-table-title">${esc(pt.table_data.title)}</div>` : ''}
        <table class="mm-stat-table">
          <thead>
            <tr>
              ${(pt.table_data.headers || []).map((h, hi) => `<th class="${hi > 0 ? 'text-right' : 'text-left'}">${esc(h)}</th>`).join('')}
            </tr>
          </thead>
          <tbody>
            ${(pt.table_data.rows || []).map(row => `
              <tr>
                ${(row || []).map((c, ci) => `<td class="${ci > 0 ? 'cell-mono text-right' : 'text-left'}">${highlightKeywords(String(c), pt.highlights)}</td>`).join('')}
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  } else if (pt.example_calc) {
    out += `
      <div class="mm-example-panel">
        <div class="mm-example-head">
          <span class="mm-example-tag">WORKED CALCULATION EXAMPLE</span>
          ${pt.example_calc.title ? `<span class="mm-example-title">${esc(pt.example_calc.title)}</span>` : ''}
        </div>
        ${pt.example_calc.inputs ? `<div class="mm-example-inputs"><b>Assumptions:</b> ${highlightKeywords(pt.example_calc.inputs, pt.highlights)}</div>` : ''}
        <div class="mm-example-steps">
          ${(pt.example_calc.steps || []).map(st => `<div class="mm-example-step-line"><span class="step-bullet">▸</span><span>${highlightKeywords(st, pt.highlights)}</span></div>`).join('')}
        </div>
      </div>
    `;
  }

  // Bullet points
  const bodyItems = Array.isArray(pt.body) ? pt.body : (pt.body ? [pt.body] : []);
  if (bodyItems.length > 0) {
    bodyItems.forEach(b => {
      out += `
        <div class="mm-card-point-row">
          <span class="mm-card-point-bullet"></span>
          <span class="mm-card-point-text">${highlightKeywords(b, pt.highlights)}</span>
        </div>
      `;
    });
  }

  return out;
}

function renderMindMapCanvasHtml(mm, q, p){
  if (!mm || !mm.branches || mm.branches.length === 0) {
    return `
      <div class="mm-canvas-container" style="display:grid;place-items:center;min-height:360px">
        <div style="text-align:center;color:#94A3B8">
          <h4 style="color:#F8FAFC;margin-bottom:6px">Mind Map Not Available for This Topic</h4>
          <p style="font-size:.85rem">Please switch to <b>Slide Detail</b> view to study this provision.</p>
        </div>
      </div>
    `;
  }

  const root = mm.root || { id: "root", title: p.doctrine, badge: "§ LAW" };

  return `
    <div class="mm-scroll-stage" id="mm-scroll-stage">
      <div class="mm-canvas-container" id="mm-canvas-container">
        <svg class="mm-connector-svg" id="mm-connector-svg" aria-hidden="true"></svg>

        <!-- Minimalist Root Card: Section Code Badge + Doctrine in One Line -->
        <div class="mm-root-card" id="mm-node-root" data-node-id="root" data-t0="0" data-t1="${root.t1 || 5.0}" tabindex="0" role="button" aria-label="Jump to start: ${esc(root.title)}">
          <div class="mm-root-pulse" aria-hidden="true"></div>
          <div class="mm-root-top-row">
            <span class="mm-root-badge">${esc(root.badge || '§ LAW')}</span>
            <span class="mm-root-step-tag">CORE STATUTORY DOCTRINE</span>
          </div>
          <div class="mm-root-title">${esc(root.title)}</div>
        </div>

        <!-- Sequential Infographic Blocks Downward (B1 -> B2 -> B3 -> B4) -->
        ${mm.branches.map((b, bi) => `
          <div class="mm-infographic-block status-hidden" id="mm-block-${b.branch_id}" data-branch-id="${b.branch_id}" data-t0="${b.t0}" data-t1="${b.t1}">
            <!-- 1. Section Title Pill -->
            <div class="mm-block-pill" id="mm-bpill-${b.branch_id}" data-t0="${b.t0}" data-branch-id="${b.branch_id}" tabindex="0" role="button" aria-label="Jump to ${esc(b.branch_title)}">
              <div class="mm-bp-icon-badge">${getIconSvg(b.icon || 'scales', 18, '#38BDF8')}</div>
              <span class="mm-bp-step">BLOCK ${bi + 1}</span>
              <span class="mm-bp-title" title="${esc(b.branch_title)}">${esc(b.branch_title)}</span>
              ${b.badge ? `<span class="mm-bp-badge">${esc(b.badge)}</span>` : ''}
              <span class="mm-card-status-tag" id="tag-b-${b.branch_id}"></span>
              <div class="mm-bp-underline"></div>
            </div>

            <!-- 2. Point Cards Row -->
            <div class="mm-cards-row" id="mm-cards-${b.branch_id}">
              ${(b.points || []).map((pt, pi) => {
                const isFull = !!(pt.table_data || pt.example_calc);
                const themeColors = ['theme-teal', 'theme-blue', 'theme-purple', 'theme-amber', 'theme-coral'];
                const theme = themeColors[pi % themeColors.length];
                const isSpk = pt.spoken === true;
                return `
                  <div class="mm-infographic-card ${theme} ${isFull ? 'card-fullwidth' : ''} status-hidden" id="mm-card-${pt.id}" data-point-id="${pt.id}" data-branch-id="${b.branch_id}" data-t0="${pt.t0 != null ? pt.t0 : ''}" data-t1="${pt.t1 != null ? pt.t1 : ''}" data-spoken="${isSpk}" tabindex="0" role="button" aria-label="${esc(pt.title)}">
                    <!-- Overlapping top-left icon badge -->
                    <div class="mm-card-icon-badge">
                      ${getIconSvg(pt.icon || 'check', 18, '#FFFFFF')}
                    </div>

                    <!-- Header Ribbon -->
                    <div class="mm-card-ribbon">
                      <span class="mm-card-title" title="${esc(pt.title)}">${esc(pt.title)}</span>
                      <span class="mm-card-status-tag" id="tag-pt-${pt.id}"></span>
                    </div>

                    <!-- Card Body -->
                    <div class="mm-card-body">
                      ${renderCardBodyContent(pt)}
                    </div>
                  </div>
                `;
              }).join('')}
            </div>

            <!-- 3. Converging Connectors SVG -->
            <div class="mm-converge-container" id="mm-conv-wrap-${b.branch_id}">
              <svg class="mm-converge-svg" id="mm-converge-${b.branch_id}" aria-hidden="true"></svg>
            </div>

            <!-- 4. Flow Summary Pill & Flow Steps Row -->
            <div class="mm-flow-pill" id="mm-fpill-${b.branch_id}" data-branch-id="${b.branch_id}" tabindex="0" role="button" aria-label="Statutory Flow Summary">
              ${getIconSvg('gear', 16, '#38BDF8')}
              <span>STATUTORY COMPUTATION FLOW</span>
            </div>

            <div class="mm-flow-steps-row" id="mm-fsteps-${b.branch_id}">
              ${(b.flow_summary || []).map((step, si) => `
                ${si > 0 ? `<div class="mm-fs-arrow">${getIconSvg('arrow_right', 16, '#64748B')}</div>` : ''}
                <div class="mm-flow-step-box status-hidden" id="mm-fstep-${b.branch_id}-${si}" data-t0="${step.t0}" data-t1="${step.t1}" data-branch-id="${b.branch_id}" tabindex="0" role="button" aria-label="Step ${si + 1}: ${esc(step.label)}">
                  <div class="mm-fs-top">
                    <span class="mm-fs-icon">${getIconSvg(step.icon || 'check', 14, '#38BDF8')}</span>
                    <span class="mm-fs-num">Step ${si + 1}</span>
                  </div>
                  <div class="mm-fs-label">${esc(step.label)}</div>
                  ${step.sub ? `<div class="mm-fs-sub">${esc(step.sub)}</div>` : ''}
                </div>
              `).join('')}
            </div>
          </div>
        `).join('')}
      </div>
    </div>

    <!-- Explaining Now Live Bar (Pinned at bottom, directly above dock) -->
    <div class="mm-live-bar" id="mm-live-bar">
      <span class="mm-live-badge"><span class="pnb-live-dot"></span>EXPLAINING NOW</span>
      <span class="mm-live-text" id="mm-live-text">Tap Play to start animated Malayalam explanation</span>
    </div>
  `;
}

function renderTheaterModalHtml(q, p){
  const qn = q.n;
  const sbKey = 'q' + qn;
  const sb = (D.storyboards && (D.storyboards[sbKey] || D.storyboards[p.file ? p.file.replace('.mp3', '') : ''])) || { slides: [] };
  const hasSlides = sb && sb.slides && sb.slides.length > 0;
  const mm = getMindMapForQuestion(q, p);
  const badgeTitle = mm && mm.root ? `${mm.root.badge} · ${mm.doctrine}` : p.doctrine;

  return `
  <div class="vtheater" id="vtheater" role="dialog" aria-modal="true" aria-label="Statutory Presentation">
    <!-- Top Navigation Bar -->
    <div class="vtheater-topbar">
      <div class="vtb-left">
        <span class="vtb-badge">§ DIRECT TAX CONCEPT TREE</span>
        <span class="vtb-title" title="${esc(badgeTitle)}">${esc(badgeTitle)}</span>
      </div>

      <!-- Center: View Switcher (Mind Map vs Slide Detail) -->
      <div class="vtb-center">
        <div class="vtb-view-switcher" role="tablist">
          <button id="btn-view-mindmap" class="vtb-view-btn active" role="tab" aria-selected="true" title="Switch to Animated Mind Map view">🧠 Mind Map</button>
          <button id="btn-view-slides" class="vtb-view-btn" role="tab" aria-selected="false" title="Switch to Detailed Slide View">🔍 Slide Detail</button>
        </div>

        ${hasSlides ? `
        <div class="ppt-nav-rail" id="ppt-nav-rail" style="display:none" role="tablist">
          ${sb.slides.map((s, idx) => `
            <button class="ppt-nav-dot ${idx === 0 ? 'active' : ''}" data-t0="${s.t0 || 0}" data-slide-idx="${idx}" title="Slide ${s.slide_number}: ${esc(s.slide_title)}" aria-label="Go to slide ${s.slide_number}">
              <span class="ppt-dot-num">${s.slide_number}</span>
              <span class="ppt-dot-label">${esc(s.slide_title)}</span>
            </button>
          `).join('')}
        </div>
        ` : ''}
      </div>

      <!-- Right: Direct Close Button -->
      <div class="vtb-right">
        <button id="vclose" class="vtb-close-btn" aria-label="Close presentation (Escape)" title="Close presentation (Escape)">
          <span style="font-size:1.1rem;line-height:1">✕</span> Close Presentation
        </button>
      </div>
    </div>

    <!-- Presentation Stage: Host for both Mind Map and Slide Detail -->
    <div id="vdiag" class="vfullscreen-stage">
      <!-- Animated Mind Map View (Default) -->
      <div class="ppt-mindmap-view" id="ppt-mindmap-view">
        ${renderMindMapCanvasHtml(mm, q, p)}
      </div>

      <!-- Detailed Slide View (Toggled) -->
      <div class="ppt-stage-wrapper" id="ppt-slides-wrapper" style="display:none">
        <button class="ppt-arrow-btn prev" id="ppt-prev-btn" title="Previous Slide (Left Arrow)" aria-label="Previous Slide">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>

        <div class="ppt-viewport">
          ${renderFlowchartHtml(q, p)}
        </div>

        <button class="ppt-arrow-btn next" id="ppt-next-btn" title="Next Slide (Right Arrow)" aria-label="Next Slide">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Synchronized Floating Bottom Dock -->
    <div class="vtheater-dock" id="vtheater-dock">
      <button class="vtd-play" id="vtd-play" aria-label="Play/Pause">${I.play}</button>
      <div class="vtd-info">
        <span id="vtd-time" class="vtd-time">0:00 / ${fmt(p.dur)}</span>
        <span id="vtd-label" class="vtd-label">Step 1: Core Statutory Doctrine</span>
      </div>
      <input type="range" class="vtd-seek" id="vtd-seek" min="0" max="1000" value="0" aria-label="Seek audio">
      <button id="vtd-speed" class="vtd-speed-pill" title="Toggle Playback Speed">1.0x</button>
      <button id="vtd-close" class="vtd-close-pill" aria-label="Close presentation" title="Close presentation">✕ Close</button>
    </div>
  </div>
  `;
}

function renderScriptDrawerContent(q, p){
  const qn = q.n;
  const sbKey = 'q' + qn;
  const sb = (D.storyboards && (D.storyboards[sbKey] || D.storyboards[p.file ? p.file.replace('.mp3', '') : '']));
  if (sb && sb.slides && sb.slides.length > 0) {
    return `
      <div class="script-slides-list">
        ${sb.slides.map(s => `
          <div class="script-slide-item">
            <div class="ssi-head">
              <span class="ssi-num">Slide ${s.slide_number}</span>
              <span class="ssi-title">${esc(s.slide_title)}</span>
              ${s.t0 != null ? `<span class="ssi-time">${s.t0}s - ${s.t1}s (${s.duration || ''}s)</span>` : ''}
            </div>
            <div class="script" lang="ml" style="font-size:1rem;line-height:1.7;color:var(--ink)">${esc(s.malayalam_narration || '')}</div>
          </div>
        `).join('')}
      </div>
    `;
  }
  return `<div class="script" lang="ml">${esc(p.ml)}</div>`;
}

function vStudio(r){
 const list=qs(r.sub,r.ch),i=list.findIndex(q=>q.n===r.n),q=list[i];
 if(!q){go(`${r.sub}-c${r.ch}`);return}
 const p=D.prov[q.topic]||{doctrine:q.title,principle:"",secs:q.secs||[],dur:60,file:`q${q.n}.mp3`,ml:""};
 const prev=list[i-1],next=list[i+1],base=`${r.sub}-c${r.ch}`;
 mount(`<div class="studio-nav rise"><button class="nav-btn" data-go="${base}">${I.back}Questions</button>
   <div class="stepper"><button class="nav-btn" ${prev?`data-go="${base}-q${prev.n}"`:"disabled"} aria-label="Previous question">${I.back}Prev</button><span class="count">Q${i+1} of ${list.length}</span>
   <button class="nav-btn" ${next?`data-go="${base}-q${next.n}"`:"disabled"} aria-label="Next question">Next${I.arrow.replace('width="22" height="22"','width="18" height="18"')}</button></div></div>
  <div class="studio"><nav class="rail rise" style="--i:2" id="rail" aria-label="Study stages">${["Provision & rules","Malayalam audio","Exam question","ICAI solution"].map((t,k)=>`<a href="#s${k+1}" data-st="${k+1}" class="${k===0?"on":""}"><b>${k+1}</b>${t}</a>`).join("")}</nav>
  <div class="stack">
   <section class="stage rise" style="--i:2" id="st1" data-s="1">${stageHead(1,"Statutory Provision & Rules Matrix")}
    <div class="prov-banner">
      <div class="prov-banner-meta">
        <span class="prov-tag">§ Statutory Doctrine</span>
        <div class="prov-secs">${(p.secs||[]).map(x=>`<span class="sec">${esc(x)}</span>`).join("")}</div>
      </div>
      <h3 class="prov-title">${esc(p.doctrine)}</h3>
    </div>
    <div class="md-content">
      ${p.rawMarkdown ? renderProvMarkdown(p.rawMarkdown, p.doctrine) : tbl(p.table)}
    </div>
   </section>
   <section class="stage rise" style="--i:3" id="st2" data-s="2">${stageHead(2,"Spoken Malayalam Explainer")}
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:-8px 0 16px">
      <p class="note" style="margin:0">Covers the statutory doctrine in clear spoken Malayalam with synchronized Keynote presentation.</p>
      <div style="display:flex;align-items:center;gap:8px">
        <span class="pill ok"><i class="dot"></i>${esc(p.voice || "Gemini Voice (Aoede)")}</span>
      </div>
    </div>

    <!-- Launch Card for Fullscreen Presentation -->
    <div class="theater-launch-card" id="vtog" role="button" tabindex="0" title="Click to launch interactive fullscreen explainer">
      <div class="tlc-badge">✨ FULLSCREEN INTERACTIVE PRESENTATION</div>
      <div class="tlc-inner">
        <div class="tlc-icon">🎬</div>
        <div class="tlc-text">
          <h4>Interactive Presentation & Visual Explainer</h4>
          <p>Watch synchronized slide-by-slide presentation with spoken Malayalam teacher explanation.</p>
        </div>
        <button class="tlc-btn" id="vtog-btn">⤢ Launch Fullscreen</button>
      </div>
    </div>

    <div class="player" id="player"><div class="wave" id="wave">${Array.from({length:56},(_,k)=>`<i style="--k:${k};--h:${22+Math.round(70*Math.abs(Math.sin(k*.9+p.dur)*Math.cos(k*.31)))}%"></i>`).join("")}</div>
     <div class="ctrl"><span class="playwrap"><svg class="pring" viewBox="0 0 64 64" aria-hidden="true"><circle class="bg" cx="32" cy="32" r="28"/><circle class="fg" id="ringc" cx="32" cy="32" r="28"/></svg><button class="play" id="play" aria-label="Play audio">${I.play}</button></span><span class="time" id="time">0:00 / ${fmt(p.dur)}</span>
      <input type="range" id="seek" min="0" max="1000" value="0" aria-label="Seek audio"><button class="speed" id="speed" aria-label="Playback speed">1.0x</button></div>
     <p class="note" id="anote"></p></div>
    <button class="drawer-btn" id="sbtn" aria-expanded="false" aria-controls="sdr">Malayalam Teacher Script & Slide Breakdown ${I.down}</button>
    <div class="drawer" id="sdr"><div class="script-drawer-body">${renderScriptDrawerContent(q, p)}</div></div></section>
   <section class="stage rise" style="--i:4" id="st3" data-s="3">${stageHead(3,"The Exam Question")}<div class="qtext">${(q.q||[]).map(x=>`<p>${esc(x)}</p>`).join("")}</div></section>
   <section class="stage rise" style="--i:5" id="st4" data-s="4">${stageHead(4,"ICAI Suggested Solution")}
    <button class="sol-toggle" id="soltog" aria-expanded="false" aria-controls="soldr"><span>Show the suggested solution</span>${I.down}</button>
    <div class="drawer" id="soldr"><div><div class="sol">
      ${q.rawAnswer ? `<div class="md-content">${renderAnswerMarkdown(q.rawAnswer)}</div>` : (q.a?.p||[]).map(x=>`<p>${esc(x)}</p>`).join("") + tbl(q.a?.t) + (q.a?.c ? `<div class="concl"><b>Conclusion.</b> ${esc(q.a.c)}</div>` : "")}
    </div></div></div></section>
  </div></div>`,r);
 bindStudio(q,p,r)}

function bindStudio(q,p,r){
 const toggle=(btn,dr,a,b)=>{const o=btn.getAttribute("aria-expanded")!=="true";btn.setAttribute("aria-expanded",o);dr.classList.toggle("open",o);if(b)b(o)};
 $("#sbtn").onclick=()=>toggle($("#sbtn"),$("#sdr"));
 const st=$("#soltog"),sd=$("#soldr");
 st.onclick=()=>{
  toggle(st, sd, null, (o)=>{
   if (o) requestAnimationFrame(() => renderMath(sd));
  });
 };
 /* stage rail */
 const links=$$("#rail a");
 links.forEach(a=>a.onclick=e=>{e.preventDefault();$("#st"+a.dataset.st).scrollIntoView({behavior:REDUCED?"auto":"smooth",block:"start"})});
 io=new IntersectionObserver(es=>es.forEach(en=>{if(!en.isIntersecting)return;const k=+en.target.dataset.s;
  links.forEach((a,j)=>{a.classList.toggle("on",j+1===k);a.classList.toggle("done",j+1<k)})}),{rootMargin:"-30% 0px -60% 0px"});
 $$(".stage").forEach(s=>io.observe(s));

 const st1 = $("#st1");
 if(st1){
  renderMath(st1);
 }

 const troot = $("#theater-root");
 if(troot){
  troot.innerHTML = renderTheaterModalHtml(q, p);
 }

  player=makePlayer(p, q);
}

/* ---------- audio player ---------- */
function makePlayer(p, q){
 const root=$("#player"),playB=$("#play"),seek=$("#seek"),time=$("#time"),spd=$("#speed"),note=$("#anote"),bars=$$("#wave i");
 const vtheater=$("#vtheater"),vtog=$("#vtog"),vclose=$("#vclose");
 const vtdClose=$("#vtd-close"),vtdPlay=$("#vtd-play"),vtdSeek=$("#vtd-seek"),vtdSpeed=$("#vtd-speed");
 const vtogBtn=$("#vtog-btn");
 const prevBtn=$("#ppt-prev-btn"),nextBtn=$("#ppt-next-btn");
 const btnViewMindmap=$("#btn-view-mindmap"),btnViewSlides=$("#btn-view-slides");
 const pptMindmapView=$("#ppt-mindmap-view"),pptSlidesWrapper=$("#ppt-slides-wrapper"),pptNavRail=$("#ppt-nav-rail");

 const mm = getMindMapForQuestion(q, p);
 const speeds=[1,1.25,1.5,2];let si=0,playing=false,vraf=0,mmRaf=0,dead=false;
 const audioFile = p.file || "q1.mp3";
 const audioBase = audioFile.startsWith('/') ? audioFile : "/audio/" + audioFile;
 const audioUrl = audioBase + "?v=aoede_" + Math.round(p.dur || 1);
 
 const audio = new Audio();
 audio.preload = "auto";
 audio.src = audioUrl;
 window.__currAudio = audio;
 window.__ui = ui;

 const total = () => (audio && isFinite(audio.duration) && audio.duration > 0) ? audio.duration : (p.dur || 75);

 const DRAW_TIME = 1.4; // seconds for progressive connector drawing

 function getState(mindmap, cur){
  if(!mindmap || !mindmap.branches) return { branchStates: {}, pointStates: {}, flowStates: {}, convergeStates: {}, activePoint: null, activeFlowStep: null, activeBranch: null, allMastered: false };
  const branchStates = {};
  const pointStates = {};
  const flowStates = {};
  const convergeStates = {};
  let activePoint = null;
  let activeFlowStep = null;
  let activeBranch = null;
  const tot = mindmap.total_duration || total();
  const allMastered = cur >= tot;

  mindmap.branches.forEach((b) => {
   let status = "hidden";
   let progress = 0;
   const t0 = parseFloat(b.t0 || 0);
   const t1 = parseFloat(b.t1 || 999);

   if(cur >= t1){
    status = "mastered";
    progress = 1;
   } else if(cur >= t0){
    activeBranch = b;
    const elapsed = cur - t0;
    if(elapsed < DRAW_TIME){
     status = "drawing";
     progress = Math.min(1, Math.max(0, elapsed / DRAW_TIME));
    } else {
     status = "active";
     progress = 1;
    }
   } else {
    status = "hidden";
    progress = 0;
   }
   branchStates[b.branch_id] = { status, progress, t0, t1 };

   // Points / Cards
   (b.points || []).forEach(pt => {
    if(pt.spoken === true){
     const pt0 = parseFloat(pt.t0 != null ? pt.t0 : t0);
     const pt1 = parseFloat(pt.t1 != null ? pt.t1 : t1);
     let pStatus = "hidden";
     if(cur >= pt1){
      pStatus = "done";
     } else if(cur >= pt0){
      pStatus = "active";
      activePoint = pt;
      activeBranch = b;
     } else {
      pStatus = "hidden";
     }
     pointStates[pt.id] = pStatus;
    } else {
     if(status === "active" || status === "mastered" || status === "drawing"){
      pointStates[pt.id] = "done";
     } else {
      pointStates[pt.id] = "hidden";
     }
    }
   });

   // Flow Summary steps
   let anyFlowActive = false;
   let allFlowDone = (b.flow_summary && b.flow_summary.length > 0);
   (b.flow_summary || []).forEach((step, si) => {
    const st0 = parseFloat(step.t0 || 0);
    const st1 = parseFloat(step.t1 || 999);
    let fStatus = "hidden";
    if(cur >= st1){
     fStatus = "done";
    } else if(cur >= st0){
     fStatus = "active";
     anyFlowActive = true;
     activeFlowStep = { branch_id: b.branch_id, step, index: si, t0: st0 };
     activeBranch = b;
     allFlowDone = false;
    } else {
     fStatus = "hidden";
     allFlowDone = false;
    }
    flowStates[b.branch_id + '_' + si] = fStatus;
   });

   // Converging connectors state
   if(allFlowDone || status === "mastered"){
    convergeStates[b.branch_id] = "done";
   } else if(anyFlowActive || (b.flow_summary && b.flow_summary.length > 0 && cur >= parseFloat(b.flow_summary[0].t0 || 0))){
    convergeStates[b.branch_id] = "active";
   } else {
    convergeStates[b.branch_id] = "hidden";
   }
  });

  return { branchStates, pointStates, flowStates, convergeStates, activePoint, activeFlowStep, activeBranch, allMastered };
 }

 let lastActiveBranchId = null;
 let lastActivePointId = null;
 let lastActiveFlowStepKey = null;
 let userScrolledUntil = 0;
 let cardResizeObserver = null;

 function scrollToCard(el, smooth = true){
  const stage = document.getElementById("mm-scroll-stage");
  if(!stage || !el) return;
  el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
 }

 function handleAutoScroll(activeBranchId, isManualScrub = false, activePointId = null, activeFlowStepKey = null){
  const stage = document.getElementById("mm-scroll-stage");
  if(!stage) return;
  const now = Date.now();

  if(isManualScrub){
   lastActiveBranchId = activeBranchId;
   lastActivePointId = activePointId;
   lastActiveFlowStepKey = activeFlowStepKey;
   userScrolledUntil = 0;
   if(activePointId){
    const pEl = document.getElementById("mm-card-" + activePointId);
    if(pEl){ scrollToCard(pEl, false); return; }
   }
   if(activeFlowStepKey){
    const fEl = document.getElementById("mm-fstep-" + activeFlowStepKey);
    if(fEl){ scrollToCard(fEl, false); return; }
   }
   if(activeBranchId === "root" || (audio.currentTime || 0) < 0.8){
    const rootEl = document.getElementById("mm-node-root");
    if(rootEl) scrollToCard(rootEl, false);
    else stage.scrollTop = 0;
   } else if(activeBranchId){
    const el = document.getElementById("mm-block-" + activeBranchId);
    if(el) scrollToCard(el, false);
   }
   return;
  }

  // Auto-scroll to active flow step
  if(now >= userScrolledUntil && activeFlowStepKey && activeFlowStepKey !== lastActiveFlowStepKey){
   lastActiveFlowStepKey = activeFlowStepKey;
   const fEl = document.getElementById("mm-fstep-" + activeFlowStepKey);
   if(fEl){
    scrollToCard(fEl, true);
    return;
   }
  }

  // Auto-scroll to active spoken point card
  if(now >= userScrolledUntil && activePointId && activePointId !== lastActivePointId){
   lastActivePointId = activePointId;
   const pEl = document.getElementById("mm-card-" + activePointId);
   if(pEl){
    scrollToCard(pEl, true);
    return;
   }
  }

  // Active branch transition
  if(activeBranchId !== lastActiveBranchId){
   lastActiveBranchId = activeBranchId;
   userScrolledUntil = 0;
   if(activeBranchId === "root"){
    const rootEl = document.getElementById("mm-node-root");
    if(rootEl) scrollToCard(rootEl, true);
    else stage.scrollTo({ top: 0, behavior: 'smooth' });
   } else if(activeBranchId){
    const el = document.getElementById("mm-block-" + activeBranchId);
    if(el) scrollToCard(el, true);
   }
   return;
  }

  if(now < userScrolledUntil) return;
 }

 function refreshMindMapLayout(){
  if(vtheater && vtheater.classList.contains("open")){
   updateConnectorPaths(getState(mm, audio.currentTime || 0));
  }
 }

 function updateConnectorPaths(st){
  if(!mm || !mm.branches) return;
  const svg = document.getElementById("mm-connector-svg");
  const container = document.getElementById("mm-canvas-container");
  const rootCard = document.getElementById("mm-node-root");
  if(!svg || !container || !rootCard) return;

  const cRect = container.getBoundingClientRect();
  let prevRect = rootCard.getBoundingClientRect();

  // 1. Inter-Block Connectors (Root -> B1 -> B2 -> B3 -> B4)
  mm.branches.forEach((b, bi) => {
   const bEl = document.getElementById("mm-bpill-" + b.branch_id);
   const blockEl = document.getElementById("mm-block-" + b.branch_id);
   if(!bEl || !blockEl) return;
   const currRect = bEl.getBoundingClientRect();

   const x0 = prevRect.left - cRect.left + prevRect.width / 2;
   const y0 = prevRect.bottom - cRect.top;
   const x1 = currRect.left - cRect.left + currRect.width / 2;
   const y1 = currRect.top - cRect.top;

   let path = document.getElementById("mm-path-" + b.branch_id);
   if(!path){
    path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.id = "mm-path-" + b.branch_id;
    path.classList.add("mm-branch-path");
    svg.appendChild(path);
   }

   const dy = y1 - y0;
   const cpOffset = (bi % 2 === 0 ? 10 : -10);
   const cp1x = x0 + cpOffset;
   const cp1y = y0 + dy * 0.45;
   const cp2x = x1 - cpOffset;
   const cp2y = y1 - dy * 0.45;
   const d = `M ${x0.toFixed(1)} ${y0.toFixed(1)} C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${x1.toFixed(1)} ${y1.toFixed(1)}`;

   if(path.getAttribute("d") !== d){
    path.setAttribute("d", d);
   }

   const bState = (st && st.branchStates && st.branchStates[b.branch_id]) || { status: "hidden", progress: 0 };
   let len = 0;
   try { len = path.getTotalLength() || 100; } catch(e){ len = 100; }

   path.style.strokeDasharray = len.toFixed(1);
   const offset = len * (1 - Math.min(1, Math.max(0, bState.progress)));
   path.style.strokeDashoffset = offset.toFixed(1);
   path.className.baseVal = `mm-branch-path path-${bState.status}`;

   // Step badge in the vertical gap
   const midX = (x0 + x1) / 2;
   const midY = (y0 + y1) / 2;
   let badgeGroup = document.getElementById("mm-badge-" + b.branch_id);
   if(!badgeGroup){
    badgeGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
    badgeGroup.id = "mm-badge-" + b.branch_id;
    badgeGroup.innerHTML = `
      <circle class="mm-badge-bg" r="13" />
      <text class="mm-badge-text" text-anchor="middle" dy="4">${bi + 1}</text>
    `;
    svg.appendChild(badgeGroup);
   }
   badgeGroup.setAttribute("transform", `translate(${midX.toFixed(1)}, ${midY.toFixed(1)})`);
   badgeGroup.className.baseVal = `mm-step-badge-group badge-${bState.status}`;

   // Chain from bottom of this block's flow steps to the next block
   const fstepsEl = document.getElementById("mm-fsteps-" + b.branch_id);
   prevRect = fstepsEl ? fstepsEl.getBoundingClientRect() : blockEl.getBoundingClientRect();

   // 2. Converging Connectors inside this block (Cards -> Flow Summary Pill)
   const convSvg = document.getElementById("mm-converge-" + b.branch_id);
   const convWrap = document.getElementById("mm-conv-wrap-" + b.branch_id);
   const flowPill = document.getElementById("mm-fpill-" + b.branch_id);
   if(convSvg && convWrap && flowPill){
    const wRect = convWrap.getBoundingClientRect();
    const fRect = flowPill.getBoundingClientRect();
    const fx = fRect.left - wRect.left + fRect.width / 2;
    const fy = 44;

    (b.points || []).forEach(pt => {
     const cEl = document.getElementById("mm-card-" + pt.id);
     if(!cEl) return;
     const cardRect = cEl.getBoundingClientRect();
     const cx = cardRect.left - wRect.left + cardRect.width / 2;
     const cy = 0;

     let cPath = document.getElementById("mm-cpath-" + pt.id);
     if(!cPath){
      cPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
      cPath.id = "mm-cpath-" + pt.id;
      cPath.classList.add("mm-converge-path");
      convSvg.appendChild(cPath);
     }

     const cd = `M ${cx.toFixed(1)} ${cy.toFixed(1)} C ${cx.toFixed(1)} ${(fy * 0.5).toFixed(1)}, ${fx.toFixed(1)} ${(fy * 0.5).toFixed(1)}, ${fx.toFixed(1)} ${fy.toFixed(1)}`;
     if(cPath.getAttribute("d") !== cd){
      cPath.setAttribute("d", cd);
     }
     const convStatus = (st && st.convergeStates && st.convergeStates[b.branch_id]) || "hidden";
     cPath.className.baseVal = `mm-converge-path path-${convStatus}`;
    });
   }
  });
 }

 function syncMindMap(cur){
  if(!mm) return;
  const st = getState(mm, cur);

  // Update Infographic Blocks
  mm.branches.forEach(b => {
   const blockEl = document.getElementById("mm-block-" + b.branch_id);
   const tagEl = document.getElementById("tag-b-" + b.branch_id);
   const bState = st.branchStates[b.branch_id] || { status: "hidden" };

   if(blockEl){
    blockEl.className = `mm-infographic-block status-${bState.status}`;
   }
   if(tagEl){
    if(bState.status === "mastered"){
     tagEl.className = "mm-card-status-tag mastered-tag";
     tagEl.textContent = "✓ Mastered";
    } else if(bState.status === "active" || bState.status === "drawing"){
     tagEl.className = "mm-card-status-tag active-tag";
     tagEl.textContent = "● Live";
    } else {
     tagEl.className = "mm-card-status-tag";
     tagEl.textContent = "";
    }
   }

   // Update Cards
   (b.points || []).forEach((pt, pi) => {
    const cardEl = document.getElementById("mm-card-" + pt.id);
    const cTagEl = document.getElementById("tag-pt-" + pt.id);
    if(cardEl){
     const pStatus = st.pointStates[pt.id] || "hidden";
     const isFull = !!(pt.table_data || pt.example_calc);
     const themeColors = ['theme-teal', 'theme-blue', 'theme-purple', 'theme-amber', 'theme-coral'];
     const theme = themeColors[pi % themeColors.length];

     cardEl.className = `mm-infographic-card ${theme} ${isFull ? 'card-fullwidth' : ''} status-${pStatus}`;
     if(cTagEl){
      if(pStatus === "active"){
       cTagEl.textContent = "● EXPLAINING NOW";
       cTagEl.style.display = "inline-block";
      } else if(pStatus === "done"){
       cTagEl.textContent = "✓ Done";
       cTagEl.style.display = "inline-block";
      } else {
       cTagEl.textContent = "";
       cTagEl.style.display = "none";
      }
     }
    }
   });

   // Update Flow Summary Pill & Steps
   const flowPill = document.getElementById("mm-fpill-" + b.branch_id);
   if(flowPill){
    const cState = st.convergeStates[b.branch_id] || "hidden";
    flowPill.className = `mm-flow-pill status-flow-${cState}`;
   }

   (b.flow_summary || []).forEach((step, si) => {
    const stepEl = document.getElementById("mm-fstep-" + b.branch_id + "-" + si);
    if(stepEl){
     const fStatus = st.flowStates[b.branch_id + '_' + si] || "hidden";
     stepEl.className = `mm-flow-step-box status-${fStatus}`;
    }
   });
  });

  // Update connector paths
  updateConnectorPaths(st);

  // Auto-scroll view smoothly to active card or flow step
  const activeBranchId = st.activeBranch ? st.activeBranch.branch_id : (cur < 1.0 ? "root" : (st.allMastered ? mm.branches[mm.branches.length - 1].branch_id : null));
  const activePointId = st.activePoint ? st.activePoint.id : null;
  const activeFlowStepKey = st.activeFlowStep ? (st.activeFlowStep.branch_id + '-' + st.activeFlowStep.index) : null;
  handleAutoScroll(activeBranchId, false, activePointId, activeFlowStepKey);

  // Update Explaining Now Live Bar
  const liveText = $("#mm-live-text");
  if(liveText){
   if(st.activePoint && st.activePoint.voice_sync_text){
    liveText.textContent = st.activePoint.voice_sync_text;
   } else if(st.activeFlowStep && st.activeFlowStep.step){
    liveText.textContent = `Flow Step ${st.activeFlowStep.index + 1}: ${st.activeFlowStep.step.label} (${st.activeFlowStep.step.sub || ''})`;
   } else if(st.activeBranch && st.activeBranch.branch_title){
    liveText.textContent = `Explaining: ${st.activeBranch.branch_title}`;
   } else if(st.allMastered){
    liveText.textContent = "✓ Complete Concept Tree Mastered!";
   } else {
    liveText.textContent = `§ ${esc(mm.doctrine)} · Spoken Malayalam Teacher Audio`;
   }
  }

  // Update Dock Label
  const vtdLabel = $("#vtd-label");
  if(vtdLabel){
   if(st.activePoint){
    vtdLabel.textContent = `${st.activeBranch ? st.activeBranch.branch_title + ' · ' : ''}${st.activePoint.title}`;
   } else if(st.activeFlowStep && st.activeFlowStep.step){
    vtdLabel.textContent = `${st.activeBranch ? st.activeBranch.branch_title + ' · ' : ''}Step: ${st.activeFlowStep.step.label}`;
   } else if(st.activeBranch){
    vtdLabel.textContent = st.activeBranch.branch_title;
   } else if(st.allMastered){
    vtdLabel.textContent = "✓ Concept Tree Complete";
   } else {
    vtdLabel.textContent = `§ ${mm.root?.badge || "Direct Tax"}`;
   }
  }
 }

 /* Auto-Hiding Controls Engine (Inactivity Timer: 2.5s) */
 let controlsTimer = null;
 let isHoveringControls = false;
 const AUTO_HIDE_DELAY = 2500;

 function resetControlsTimer(){
  if(!vtheater || !vtheater.classList.contains("open")) return;
  vtheater.classList.remove("controls-hidden");
  clearTimeout(controlsTimer);
  if(!isHoveringControls){
   controlsTimer = setTimeout(() => {
    if(playing && vtheater && vtheater.classList.contains("open") && !isHoveringControls){
     vtheater.classList.add("controls-hidden");
    }
   }, AUTO_HIDE_DELAY);
  }
 }

 const topbarEl = vtheater ? vtheater.querySelector(".vtheater-topbar") : null;
 const dockEl = vtheater ? vtheater.querySelector(".vtheater-dock") : null;

 const onControlEnter = () => { isHoveringControls = true; resetControlsTimer(); };
 const onControlLeave = () => { isHoveringControls = false; resetControlsTimer(); };

 if(topbarEl){
  topbarEl.addEventListener("mouseenter", onControlEnter);
  topbarEl.addEventListener("mouseleave", onControlLeave);
 }
 if(dockEl){
  dockEl.addEventListener("mouseenter", onControlEnter);
  dockEl.addEventListener("mouseleave", onControlLeave);
 }

 const onUserActivity = () => {
  resetControlsTimer();
 };

 if(vtheater){
  vtheater.addEventListener("mousemove", onUserActivity, { passive: true });
  vtheater.addEventListener("pointermove", onUserActivity, { passive: true });
  vtheater.addEventListener("mousedown", onUserActivity, { passive: true });
  vtheater.addEventListener("touchstart", onUserActivity, { passive: true });
  vtheater.addEventListener("click", onUserActivity, { passive: true });
 }

 function openTheater(){
  if(vtheater){
   vtheater.style.removeProperty("display");
   vtheater.classList.add("open");
   vtheater.classList.remove("controls-hidden");
  }
  document.body.style.overflow = "hidden";
  resetControlsTimer();
  requestAnimationFrame(refreshMindMapLayout);
  setTimeout(refreshMindMapLayout, 100);
  if(!playing) start();
 }

 function closeTheater(){
  if(vtheater){
   vtheater.classList.remove("open");
   vtheater.classList.remove("controls-hidden");
   vtheater.style.setProperty("display", "none", "important");
  }
  clearTimeout(controlsTimer);
  document.body.style.overflow = "";
  stop();
 }

 function ui(){
  const cur = audio.currentTime || 0;
  const T = total();
  const f = T > 0 ? Math.min(1, Math.max(0, cur / T)) : 0;
  time.textContent = fmt(cur) + " / " + fmt(T);
  seek.value = Math.round(f * 1000);
  seek.style.setProperty("--p", f);
  const n = Math.round(f * bars.length);
  bars.forEach((b, k) => b.classList.toggle("on", k < n));
  const rc = $("#ringc");
  if(rc) rc.style.strokeDashoffset = 175.9 * (1 - f);
  const vtdTime = $("#vtd-time");
  if(vtdTime) vtdTime.textContent = fmt(cur) + " / " + fmt(T);
  const vtdSeek = $("#vtd-seek");
  if(vtdSeek) vtdSeek.value = Math.round(f * 1000);
  const curVtdPlay = $("#vtd-play");
  if(curVtdPlay) curVtdPlay.innerHTML = playing ? I.pause : I.play;

  syncMindMap(cur);
  syncFlowchart(cur);
 }

 function syncFlowchart(cur){
  const slides = $$(".ppt-slide");
  if(slides && slides.length > 0){
   let activeIdx = 0;
   slides.forEach((slide, idx) => {
    const t0 = parseFloat(slide.dataset.t0 || "0");
    const t1 = parseFloat(slide.dataset.t1 || "9999");
    if(cur >= t0 && cur < t1){
     activeIdx = idx;
    }
   });

   slides.forEach((slide, idx) => {
    const wasActive = slide.classList.contains("active");
    const shouldBeActive = (idx === activeIdx);
    if(shouldBeActive && !wasActive){
     slide.classList.add("active");
    } else if(!shouldBeActive && wasActive){
     slide.classList.remove("active");
    }
   });

   const dots = $$(".ppt-nav-dot");
   if(dots && dots.length > 0){
    dots.forEach((dot, idx) => {
     dot.classList.toggle("active", idx === activeIdx);
     dot.classList.toggle("past", idx < activeIdx);
    });
   }

   if(pptSlidesWrapper && pptSlidesWrapper.style.display !== "none"){
    const vtdLabel = $("#vtd-label");
    if(vtdLabel && slides[activeIdx]){
     const sTitle = slides[activeIdx].querySelector(".ppt-slide-title");
     vtdLabel.textContent = `Slide ${activeIdx + 1} of ${slides.length}: ${sTitle ? sTitle.textContent : ''}`;
    }
   }
  }
 }

 function vizOn(){
  cancelAnimationFrame(vraf);
  (function f(n){
   if(!playing || dead) return;
   const q = n / 1000 * speeds[si];
   bars.forEach((b, k) => {
    b.style.transform = "scaleY(" + (.55 + .45 * Math.sin(q * 5 + k * .6) * Math.cos(q * 2.3 + k * .21)).toFixed(3) + ")";
   });
   vraf = requestAnimationFrame(f);
  })(performance.now());
 }

 function vizOff(){
  bars.forEach(b => b.style.transform = "");
 }

 function startMindMapDrawLoop(){
  cancelAnimationFrame(mmRaf);
  (function loop(){
   if(!playing || dead) return;
   const cur = audio.currentTime || 0;
   syncMindMap(cur);
   mmRaf = requestAnimationFrame(loop);
  })();
 }

 function stopMindMapDrawLoop(){
  cancelAnimationFrame(mmRaf);
 }

 async function start(){
  try {
   if(audio.ended || (audio.currentTime >= total() - 0.2)){
    audio.currentTime = 0;
   }
   audio.playbackRate = speeds[si];
   await audio.play();
   playing = true;
   root.classList.add("playing");
   playB.innerHTML = I.pause;
   playB.setAttribute("aria-label", "Pause audio");
   note.textContent = "Playing Malayalam explainer: " + (p.doctrine || "Statutory Rule") + " · " + (p.voice || "Gemini Voice (Aoede)");
   if(vtheater){
    vtheater.style.removeProperty("display");
    vtheater.classList.add("open");
    document.body.style.overflow = "hidden";
   }
   const curVtdPlay = $("#vtd-play");
   if(curVtdPlay) curVtdPlay.innerHTML = I.pause;
   resetControlsTimer();
   vizOn();
   startMindMapDrawLoop();
  } catch(err) {
   console.warn("audio.play() error:", err);
   note.textContent = "Tap play to start audio playback (" + (err.message || "User interaction required") + ")";
   stop();
  }
 }

 function stop(){
  playing = false;
  try { audio.pause(); } catch(e){}
  const curVtdPlay = $("#vtd-play");
  if(curVtdPlay) curVtdPlay.innerHTML = I.play;
  cancelAnimationFrame(vraf);
  stopMindMapDrawLoop();
  vizOff();
  root.classList.remove("playing");
  playB.innerHTML = I.play;
  playB.setAttribute("aria-label", "Play audio");
  if(vtheater) vtheater.classList.remove("controls-hidden");
  clearTimeout(controlsTimer);
 }

 function finish(){
  stop();
  audio.currentTime = total();
  ui();
 }

 const togglePlay = (e) => {
  if (e) {
   e.preventDefault();
   e.stopPropagation();
  }
  if (playing) stop();
  else start();
 };

 playB.onclick = togglePlay;
 const wrap = root.querySelector(".playwrap");
 if (wrap) wrap.onclick = togglePlay;

 seek.oninput = () => {
  const T = total();
  const target = (seek.value / 1000) * T;
  if(isFinite(target)){
   audio.currentTime = target;
  }
  ui();
  const cur = audio.currentTime || 0;
  const st = getState(mm, cur);
  const activeId = st.activeBranch ? st.activeBranch.branch_id : (cur < 1.0 ? "root" : (st.allMastered ? mm.branches[mm.branches.length - 1].branch_id : null));
  handleAutoScroll(activeId, true, st.activePoint?.id, st.activeFlowStep ? (st.activeFlowStep.branch_id + '-' + st.activeFlowStep.index) : null);
 };

 spd.onclick = () => {
  si = (si + 1) % speeds.length;
  const txt = speeds[si] === 1 ? "1.0x" : speeds[si] + "x";
  spd.textContent = txt;
  if(vtdSpeed) vtdSpeed.textContent = txt;
  audio.playbackRate = speeds[si];
 };

 if(vtog) vtog.onclick = openTheater;
 if(vtogBtn) vtogBtn.onclick = (e) => { e.stopPropagation(); openTheater(); };
 if(vclose) vclose.onclick = closeTheater;
 if(vtdClose) vtdClose.onclick = closeTheater;

 if(vtdPlay){
  vtdPlay.onclick = () => {
   if(playing) stop();
   else start();
  };
 }

 if(vtdSeek){
  vtdSeek.oninput = () => {
   const T = total();
   const target = (vtdSeek.value / 1000) * T;
   if(isFinite(target)){
    audio.currentTime = target;
   }
   ui();
   const cur = audio.currentTime || 0;
   const st = getState(mm, cur);
   const activeId = st.activeBranch ? st.activeBranch.branch_id : (cur < 1.0 ? "root" : (st.allMastered ? mm.branches[mm.branches.length - 1].branch_id : null));
   handleAutoScroll(activeId, true, st.activePoint?.id, st.activeFlowStep ? (st.activeFlowStep.branch_id + '-' + st.activeFlowStep.index) : null);
  };
 }

 if(vtdSpeed){
  vtdSpeed.onclick = () => {
   si = (si + 1) % speeds.length;
   const txt = speeds[si] === 1 ? "1.0x" : speeds[si] + "x";
   spd.textContent = txt;
   vtdSpeed.textContent = txt;
   audio.playbackRate = speeds[si];
  };
 }

 /* View Switcher Event Handlers */
 if(btnViewMindmap){
  btnViewMindmap.onclick = () => {
   if(pptMindmapView) pptMindmapView.style.display = "flex";
   if(pptSlidesWrapper) pptSlidesWrapper.style.display = "none";
   if(pptNavRail) pptNavRail.style.display = "none";
   btnViewMindmap.classList.add("active");
   btnViewMindmap.setAttribute("aria-selected", "true");
   if(btnViewSlides){
    btnViewSlides.classList.remove("active");
    btnViewSlides.setAttribute("aria-selected", "false");
   }
   requestAnimationFrame(refreshMindMapLayout);
   setTimeout(refreshMindMapLayout, 80);
  };
 }

 if(btnViewSlides){
  btnViewSlides.onclick = () => {
   if(pptMindmapView) pptMindmapView.style.display = "none";
   if(pptSlidesWrapper) pptSlidesWrapper.style.display = "flex";
   if(pptNavRail) pptNavRail.style.display = "inline-flex";
   btnViewSlides.classList.add("active");
   btnViewSlides.setAttribute("aria-selected", "true");
   if(btnViewMindmap){
    btnViewMindmap.classList.remove("active");
    btnViewMindmap.setAttribute("aria-selected", "false");
   }
   syncFlowchart(audio.currentTime || 0);
  };
 }

 /* Mind Map Root Node Clicks */
 const rootNode = $("#mm-node-root");
 if(rootNode){
  rootNode.onclick = (e) => {
   e.stopPropagation();
   audio.currentTime = 0;
   if(!playing) start();
   ui();
   handleAutoScroll("root", true);
  };
 }

 /* Section Title Pill Clicks */
 $$(".mm-block-pill").forEach(pill => {
  pill.onclick = (e) => {
   e.stopPropagation();
   const t0 = parseFloat(pill.dataset.t0 || "0");
   audio.currentTime = t0 + 0.05;
   if(!playing) start();
   ui();
   handleAutoScroll(pill.dataset.branchId, true);
  };
 });

 /* Infographic Card Clicks (Seek to card t0) */
 $$(".mm-infographic-card").forEach(el => {
  el.onclick = (e) => {
   e.stopPropagation();
   const rawT0 = el.dataset.t0;
   if(rawT0 !== "" && !isNaN(parseFloat(rawT0))){
    const t0 = parseFloat(rawT0);
    audio.currentTime = t0 + 0.05;
    if(!playing) start();
    ui();
    handleAutoScroll(el.dataset.branchId, true, el.dataset.pointId);
   }
  };
  el.onkeydown = (e) => {
   if(e.key === "Enter" || e.key === " "){
    e.preventDefault();
    el.click();
   }
  };
 });

 /* Flow Summary Step Box Clicks (Seek to step t0) */
 $$(".mm-flow-step-box").forEach(el => {
  el.onclick = (e) => {
   e.stopPropagation();
   const rawT0 = el.dataset.t0;
   if(rawT0 !== "" && !isNaN(parseFloat(rawT0))){
    const t0 = parseFloat(rawT0);
    audio.currentTime = t0 + 0.05;
    if(!playing) start();
    ui();
    const idParts = el.id.replace("mm-fstep-", "").split("-");
    const stepKey = idParts.join("-");
    handleAutoScroll(el.dataset.branchId, true, null, stepKey);
   }
  };
  el.onkeydown = (e) => {
   if(e.key === "Enter" || e.key === " "){
    e.preventDefault();
    el.click();
   }
  };
 });

 $$(".ppt-nav-dot").forEach(dot => {
  dot.onclick = (e) => {
   e.stopPropagation();
   const t0 = parseFloat(dot.dataset.t0 || "0");
   audio.currentTime = t0;
   if(!playing) start();
   ui();
  };
 });

 if(prevBtn){
  prevBtn.onclick = (e) => {
   e.stopPropagation();
   const slides = $$(".ppt-slide");
   if(!slides.length) return;
   let curIdx = 0;
   slides.forEach((s, idx) => { if(s.classList.contains("active")) curIdx = idx; });
   const targetIdx = Math.max(0, curIdx - 1);
   const t0 = parseFloat(slides[targetIdx].dataset.t0 || "0");
   audio.currentTime = t0;
   if(!playing) start();
   ui();
  };
 }

 if(nextBtn){
  nextBtn.onclick = (e) => {
   e.stopPropagation();
   const slides = $$(".ppt-slide");
   if(!slides.length) return;
   let curIdx = 0;
   slides.forEach((s, idx) => { if(s.classList.contains("active")) curIdx = idx; });
   const targetIdx = Math.min(slides.length - 1, curIdx + 1);
   const t0 = parseFloat(slides[targetIdx].dataset.t0 || "0");
   audio.currentTime = t0;
   if(!playing) start();
   ui();
  };
 }

 $$(".flow-node").forEach(node => {
  node.onclick = (e) => {
   e.stopPropagation();
   const t0 = parseFloat(node.dataset.t0 || "0");
   audio.currentTime = t0;
   if(!playing) start();
   ui();
  };
 });

 const globalClickHandler = (e) => {
  if (e.target.closest("#vclose") || e.target.closest("#vtd-close") || e.target.closest(".vtb-close-btn") || e.target.closest(".vtd-close-pill")) {
   e.preventDefault();
   e.stopPropagation();
   closeTheater();
  }
 };
 document.addEventListener("click", globalClickHandler);

 const keyListener = (e) => {
  if(vtheater && vtheater.classList.contains("open")){
   if(e.key === "Escape"){
    closeTheater();
   } else if(e.key === " " && e.target.tagName !== "INPUT" && e.target.tagName !== "BUTTON"){
    e.preventDefault();
    if(playing) stop();
    else start();
   } else if(e.key === "ArrowLeft"){
    if(prevBtn) prevBtn.click();
   } else if(e.key === "ArrowRight"){
    if(nextBtn) nextBtn.click();
   }
  }
 };
 window.addEventListener("keydown", keyListener);

 const mmScrollStage = document.getElementById("mm-scroll-stage");
 const onUserScroll = () => {
  userScrolledUntil = Date.now() + 4000;
 };
 if(mmScrollStage){
  mmScrollStage.addEventListener("wheel", onUserScroll, { passive: true });
  mmScrollStage.addEventListener("touchstart", onUserScroll, { passive: true });
  mmScrollStage.addEventListener("touchmove", onUserScroll, { passive: true });
 }

 if(window.ResizeObserver){
  cardResizeObserver = new ResizeObserver(() => {
   refreshMindMapLayout();
  });
  const rootEl = document.getElementById("mm-node-root");
  if(rootEl) cardResizeObserver.observe(rootEl);
  document.querySelectorAll(".mm-infographic-block").forEach(el => cardResizeObserver.observe(el));
 }

 const resizeHandler = () => {
  if(vtheater && vtheater.classList.contains("open")){
   refreshMindMapLayout();
  }
 };
 window.addEventListener("resize", resizeHandler);
 window.addEventListener("orientationchange", resizeHandler);
 if(document.fonts) document.fonts.ready.then(refreshMindMapLayout);

 audio.ontimeupdate = ui;
 audio.onseeking = ui;
 audio.onseeked = ui;
 audio.onratechange = ui;
 audio.onended = finish;
 audio.onerror = () => {
  console.warn("Audio error for", audioUrl);
  note.textContent = "Audio unavailable (" + audioUrl + "). Review provision text below.";
 };

 return {
  destroy(){
   dead = true;
   clearTimeout(controlsTimer);
   if(cardResizeObserver){
    cardResizeObserver.disconnect();
    cardResizeObserver = null;
   }
   if(mmScrollStage){
    mmScrollStage.removeEventListener("wheel", onUserScroll);
    mmScrollStage.removeEventListener("touchstart", onUserScroll);
    mmScrollStage.removeEventListener("touchmove", onUserScroll);
   }
   if(vtheater){
    vtheater.removeEventListener("mousemove", onUserActivity);
    vtheater.removeEventListener("pointermove", onUserActivity);
    vtheater.removeEventListener("mousedown", onUserActivity);
    vtheater.removeEventListener("touchstart", onUserActivity);
    vtheater.removeEventListener("click", onUserActivity);
   }
   if(topbarEl){
    topbarEl.removeEventListener("mouseenter", onControlEnter);
    topbarEl.removeEventListener("mouseleave", onControlLeave);
   }
   if(dockEl){
    dockEl.removeEventListener("mouseenter", onControlEnter);
    dockEl.removeEventListener("mouseleave", onControlLeave);
   }
   window.removeEventListener("keydown", keyListener);
   window.removeEventListener("resize", resizeHandler);
   window.removeEventListener("orientationchange", resizeHandler);
   document.removeEventListener("click", globalClickHandler);
   stop();
   audio.src = "";
   const troot = $("#theater-root");
   if(troot) troot.innerHTML = "";
   document.body.style.overflow = "";
  }
 };
}

/* ---------- global ---------- */
document.addEventListener("click",e=>{const g=e.target.closest("[data-go]");if(g&&!g.disabled){go(g.dataset.go)}
 const c=e.target.closest(".chip");if(c){chState.f=c.dataset.f;$$(".chip").forEach(x=>x.setAttribute("aria-pressed",x===c));drawChapters(parse())}});
document.addEventListener("keydown",e=>{if(parse().v!=="studio"||/INPUT|TEXTAREA/.test(e.target.tagName))return;
 const k=e.key==="ArrowRight"?"Next":e.key==="ArrowLeft"?"Prev":null;if(!k)return;
 const b=$$(".stepper .nav-btn").find(x=>x.textContent.trim()===k);if(b&&!b.disabled)b.click()});
addEventListener("scroll",()=>$("#bar").classList.toggle("scrolled",scrollY>8),{passive:true});
$("#themeBtn").onclick=()=>{const r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme: dark)").matches;
 const n=dark?"light":"dark";r.dataset.theme=n;store.set("tsTheme",n)};
(()=>{const t=store.get("tsTheme");if(t)document.documentElement.dataset.theme=t})();



/* network of drifting nodes that reacts to the pointer */
(function(){if(REDUCED)return;const cv=document.createElement("canvas");cv.id="net";$("#ambient").prepend(cv);const x=cv.getContext("2d");
 let W,H,P=[],mx=-999,my=-999,cols=["#888","#888","#888"],fr=0;
 const read=()=>{const c=getComputedStyle(document.body);cols=["--dt","--idt","--ink-2"].map(v=>c.getPropertyValue(v).trim())};
 function size(){const d=Math.min(2,devicePixelRatio||1);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;cv.style.width=W+"px";cv.style.height=H+"px";x.setTransform(d,0,0,d,0,0);
  const n=Math.round(Math.min(80,W*H/18000));P=Array.from({length:n},(_,i)=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,r:1.2+Math.random()*1.8,k:i%2}))}
 addEventListener("resize",size);addEventListener("pointermove",e=>{mx=e.clientX;my=e.clientY},{passive:true});
 (function f(){requestAnimationFrame(f);if(document.hidden)return;if(fr++%90===0)read();x.clearRect(0,0,W,H);
  for(const p of P){p.x+=p.vx;p.y+=p.vy;if(p.x<-20)p.x=W+20;if(p.x>W+20)p.x=-20;if(p.y<-20)p.y=H+20;if(p.y>H+20)p.y=-20;
   const dx=p.x-mx,dy=p.y-my,d=Math.hypot(dx,dy);if(d<150&&d>0){p.x+=dx/d*(150-d)*.012;p.y+=dy/d*(150-d)*.012}}
  x.lineWidth=1;
  for(let i=0;i<P.length;i++){const a=P[i];
   for(let j=i+1;j<P.length;j++){const b=P[j],d=Math.hypot(a.x-b.x,a.y-b.y);if(d<130){x.globalAlpha=(1-d/130)*.3;x.strokeStyle=cols[a.k];x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}}
   const dm=Math.hypot(a.x-mx,a.y-my);if(dm<170){x.globalAlpha=(1-dm/170)*.55;x.strokeStyle=cols[1-a.k];x.beginPath();x.moveTo(a.x,a.y);x.lineTo(mx,my);x.stroke()}
   x.globalAlpha=.7;x.fillStyle=cols[a.k];x.beginPath();x.arc(a.x,a.y,a.r,0,7);x.fill()}
  x.globalAlpha=1})();size();read()})();

/* 3D tilt for the subject doors, spotlight for every other card */
app.addEventListener("pointermove",e=>{
 const d=e.target.closest(".door");
 if(d&&!REDUCED){const b=d.getBoundingClientRect(),px=(e.clientX-b.left)/b.width*2-1,py=(e.clientY-b.top)/b.height*2-1;
  d.classList.remove("leave");d.style.setProperty("--rx",(-py*5).toFixed(2)+"deg");d.style.setProperty("--ry",(px*6).toFixed(2)+"deg");d.style.setProperty("--px",px.toFixed(2));d.style.setProperty("--py",py.toFixed(2))}
 const c=e.target.closest(".row,.q,.stage,.cluster");
 if(c){const b=c.getBoundingClientRect();c.style.setProperty("--mx",e.clientX-b.left+"px");c.style.setProperty("--my",e.clientY-b.top+"px")}});
app.addEventListener("pointerout",e=>{const d=e.target.closest(".door");if(d&&!d.contains(e.relatedTarget)){d.classList.add("leave");["--rx","--ry","--px","--py"].forEach(v=>d.style.removeProperty(v))}});

/* reading progress */
const prog=document.createElement("div");prog.className="prog";document.body.appendChild(prog);
addEventListener("scroll",()=>{const h=document.documentElement.scrollHeight-innerHeight;prog.style.transform="scaleX("+(h>0?Math.min(1,scrollY/h):0).toFixed(4)+")"},{passive:true});



if(synthOK()){try{speechSynthesis.getVoices()}catch(e){}}
function synthOK(){return"speechSynthesis"in window}
render();
</script>
</body></html>
