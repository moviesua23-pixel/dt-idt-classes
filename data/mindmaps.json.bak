        "points": [
          {
            "id": "p_b2_1",
            "type": "rate",
            "icon": "percent",
            "title": "Slab Progression",
            "body": "When income exceeds the threshold, the full rebate is lost, and tax is calculated at progressive rates, necessitating relief.",
            "highlights": [
              "Rebate Lost",
              "Progressive Rates"
            ],
            "spoken": true,
            "reference": false,
            "t0": 18.33,
            "t1": 31.79,
            "voice_sync_text": "എന്നാൽ വരുമാനം 12 ലക്ഷത്തിൽ കവിയുമ്പോൾ ഈ പൂർണ്ണ റീബേറ്റ് നഷ്ടപ്പെടുകയും ഉയർന്ന സ്ലാബ് നിരക്കിൽ നികുതി വരികയും ചെയ്യുന്നു."
          },
          {
            "id": "p_b2_2",
            "type": "table",
