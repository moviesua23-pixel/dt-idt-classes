  "q8": {
    "topic_id": "q8",
    "section_code": "Section 115BAC, Section 87A",
    "doctrine": "Marginal Relief under Section 87A in Default Tax Regime",
    "total_duration": 69.0,
    "audio_file": "q8.mp3",
    "review_flag": true,
    "root": {
      "id": "root",
      "title": "Marginal Relief u/s 87A",
      "badge": "§ 115BAC & 87A",
      "summary": "A statutory mechanism ensuring that the tax payable on income marginally exceeding the threshold does not exceed the extra income earned, specifically applicable under the Default Tax Regime.",
      "t0": 0.0,
      "t1": 5.0
    },
    "branches": [
      {
        "branch_id": "b1_concept",
        "branch_title": "Concept Overview: Marginal Relief",
        "badge": "§ 87A Proviso",
        "icon": "shield",
        "t0": 0.0,
        "t1": 17.93,
        "points": [
          {
            "id": "p_b1_1",
            "type": "rule",
            "icon": "shield",
            "title": "Relief Objective",
            "body": "Prevents the tax burden from exceeding the actual increase in income when total income crosses the rebate threshold.",
            "highlights": [
              "Tax Burden",
              "Rebate Threshold"
            ],
            "table_data": null,
            "example_calc": null,
            "trap_data": null,
            "spoken": true,
            "reference": false,
            "t0": 0.0,
            "t1": 4.78,
            "voice_sync_text": "സെക്ഷൻ 87A പ്രകാരമുള്ള റീബേറ്റ് പരിധിയിൽ നിന്നും വരുമാനം നേരിയ തോതിൽ കൂടുമ്പോൾ ഉണ്ടാകുന്ന അമിത നികുതി ഭാരം ഒഴിവാക്കാനാണ് മാർജിനൽ റിലീഫ് നൽകുന്നത്."
          },
          {
            "id": "p_b1_2",
            "type": "condition",
            "icon": "scales",
            "title": "Income Protection",
            "body": "Ensures that the taxpayer is not penalized for earning slightly more than the threshold limit.",
            "highlights": [
              "Income Protection"
            ],
            "spoken": true,
            "reference": false,
            "t0": 4.78,
            "t1": 9.56,
            "voice_sync_text": "അധികമായി ലഭിച്ച വരുമാനത്തേക്കാൾ കൂടുതൽ നികുതി നൽകേണ്ടി വരുന്ന സാഹചര്യം ഇത് തടയുന്നു."
          },
          {
            "id": "p_b1_3",
            "type": "rule",
            "icon": "rupee",
            "title": "Default Regime Threshold",
            "body": "Under Section 115BAC, income up to ₹ 7,00,000 is generally exempt via rebate, but marginal relief extends this logic to higher brackets like ₹ 12,00,000 in specific cases.",
            "highlights": [
              "₹ 12,00,000",
              "Default Regime"
            ],
            "spoken": true,
            "reference": false,
            "t0": 9.56,
            "t1": 14.34,
            "voice_sync_text": "ഡിഫോൾട്ട് റെജീമിൽ 12 ലക്ഷം രൂപ വരെയുള്ള നികുതി സെക്ഷൻ 87A പ്രകാരം പൂർണ്ണമായും ഒഴിവാക്കപ്പെടുന്നു."
          }
        ],
        "flow_summary": [
          {
            "label": "Identify Income",
            "sub": "Resident Individual",
            "icon": "user",
            "t0": 14.34,
            "t1": 15.54
          },
          {
