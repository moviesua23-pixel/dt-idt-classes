      {
        "branch_id": "b3_calc",
        "branch_title": "Marginal Relief Formula",
        "badge": "§ 87A Calculation",
        "icon": "rupee",
        "t0": 35.55,
        "t1": 53.62,
        "points": [
          {
            "id": "p_b3_1",
            "type": "formula",
            "icon": "calculator",
            "title": "The Proviso Limit",
            "body": "Tax payable cannot exceed the income that is in excess of the threshold limit (e.g., ₹ 12,00,000).",
            "highlights": [
              "Tax ≤ Excess Income"
            ],
            "spoken": true,
            "reference": false,
            "t0": 35.55,
            "t1": 40.37,
            "voice_sync_text": "സെക്ഷൻ 87A പ്രൊവിസോ പ്രകാരം നൽകേണ്ട അധിക നികുതി 12 ലക്ഷത്തിന് മുകളിലുള്ള അധിക വരുമാനത്തേക്കാൾ കവിയാൻ പാടില്ല."
          },
          {
            "id": "p_b3_2",
            "type": "rule",
            "icon": "scales",
            "title": "Relief Quantification",
            "body": "Marginal Relief = (Tax on Total Income) - (Total Income - Threshold).",
            "highlights": [
              "Difference = Relief"
            ],
            "spoken": true,
            "reference": false,
            "t0": 40.37,
            "t1": 45.19,
            "voice_sync_text": "അതായത് സ്ലാബ് പ്രകാരമുള്ള നികുതിയും അധിക വരുമാനവും തമ്മിലുള്ള വ്യത്യാസം മാർജിനൽ റിലീഫ് ആയി കുറവ് ചെയ്യപ്പെടുന്നു."
          },
          {
            "id": "p_b3_3",
            "type": "levy",
            "icon": "percent",
            "title": "Cess Application",
            "body": "4% Health & Education Cess must be applied only AFTER deducting the marginal relief from the base tax.",
            "highlights": [
              "Cess after Relief"
            ],
            "spoken": true,
            "reference": false,
            "t0": 45.19,
            "t1": 50.01,
            "voice_sync_text": "പരീക്ഷയിൽ ഓർക്കുക മാർജിനൽ റിലീഫ് കുറച്ച ശേഷമുള്ള നെറ്റ് ടാക്സ് തുകയിൽ മാത്രമേ 4% ഹെൽത്ത് ആൻഡ് എജുക്കേഷൻ സെസ്സ് കൂട്ടിച്ചേർക്കാവൂ."
          },
          {
            "id": "p_b3_4",
            "type": "example",
            "icon": "cap",
            "title": "Worked Example: Mr. Nitin",
            "body": "Calculation for Total Income of ₹ 12,50,000.",
            "highlights": [
              "Relief: ₹ 17,500",
              "Final Tax: ₹ 52,000"
            ],
            "spoken": false,
            "reference": true,
            "t0": null,
            "t1": null,
            "voice_sync_text": null,
            "example_calc": {
              "title": "Computation for Mr. Nitin (TI: ₹ 12,50,000)",
              "inputs": "Resident | Default Regime | TI ₹ 12,50,000",
              "steps": [
                "Step 1: Excess Income (12.5L - 12L) = ₹ 50,000 (A)",
                "Step 2: Tax on 12.5L = ₹ 60,000 (up to 12L) + 15% of 50k = ₹ 67,500 (B)",
                "Step 3: Since B > A, Rebate u/s 87A = B - A = ₹ 17,500",
                "Step 4: Tax before Cess = ₹ 67,500 - ₹ 17,500 = ₹ 50,000",
                "Step 5: Add 4% HEC = ₹ 2,000",
                "Final Tax Liability = ₹ 52,000"
              ]
            }
          }
        ],
        "flow_summary": [
