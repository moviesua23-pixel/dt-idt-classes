          {
            "id": "p_b4_1",
            "type": "trap",
            "icon": "warning",
            "title": "Cess Sequence Error",
            "body": "Students often calculate Cess before deducting Marginal Relief. This is legally incorrect.",
            "highlights": [
              "Cess after Relief"
            ],
            "spoken": true,
            "reference": false,
            "t0": 57.94,
            "t1": 71.36,
            "voice_sync_text": "പരീക്ഷയിലെ പ്രധാന കാര്യം: Marginal Relief കണക്കാക്കുന്നത് surcharge-ന്മേൽ മാത്രമാണ്. Marginal Relief കുറച്ച ശേഷം ലഭിക്കുന്ന തുകയ്ക്ക് മുകളിലാണ് 4% Health & Education Cess കണക്കാക്കേണ്ടത്, മുൻപല്ല.",
            "trap_data": {
              "mistake": "Applying 4% HEC on the gross (Tax + Surcharge) before subtracting Marginal Relief.",
              "statutory_rule": "HEC must be levied on the net amount after Marginal Relief is adjusted."
            }
          },
          {
            "id": "p_b4_2",
            "type": "trap",
            "icon": "warning",
            "title": "Turnover Year Trap",
            "body": "Base tax rate (25%) depends on turnover of P.Y. 2022-23, not the current year.",
            "highlights": [
              "P.Y. 2022-23"
            ],
            "spoken": false,
            "reference": true,
            "t0": null,
            "t1": null,
            "voice_sync_text": null,
            "trap_data": {
              "mistake": "Using current year turnover to determine the 25% tax rate eligibility.",
              "statutory_rule": "The Finance Act specifies the turnover of the year before the previous year (P.Y. 2022-23 for A.Y. 2025-26)."
            }
          }
        ],
        "flow_summary": [
