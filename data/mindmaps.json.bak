        "t1": 57.54,
        "points": [
          {
            "id": "p_b3_1",
            "type": "formula",
            "icon": "calculator",
            "title": "Relief Computation Formula",
            "body": "Marginal Relief = (Tax + Surcharge) - [Tax on ₹ 1 Crore + (Total Income - ₹ 1 Crore)]",
            "highlights": [
              "Tax + Surcharge",
              "Tax on ₹ 1 Crore"
            ],
            "spoken": true,
            "reference": false,
            "t0": 39.68,
            "t1": 43.84,
            "voice_sync_text": "പരീക്ഷയിലെ പ്രധാന കാര്യം marginal relief കണക്കാക്കുന്നത് surcharge-ിന് മേൽ മാത്രമാണ്."
          },
          {
            "id": "p_b3_2",
            "type": "levy",
            "icon": "percent",
            "title": "HEC Calculation Order",
            "body": "4% Health & Education Cess is applied on (Tax + Surcharge - Marginal Relief).",
            "highlights": [
              "4% Cess",
              "Post-Relief"
            ],
            "spoken": true,
            "reference": false,
            "t0": 43.84,
            "t1": 53.91,
            "voice_sync_text": "Marginal relief കുറച്ച ശേഷം ലഭിക്കുന്ന തുകയ്ക്ക് മുകളിലാണ് 4 ശതമാനം health and education cess കണക്കാക്കേണ്ടത്. മുമ്പല്ല."
          },
          {
            "id": "p_b3_3",
            "type": "example",
            "icon": "cap",
            "title": "Worked Example: X Ltd",
            "body": "Computation for Total Income of ₹ 1,01,00,000.",
            "highlights": [
              "Relief: ₹ 1,42,100",
              "Tax: ₹ 31,00,000"
            ],
            "spoken": false,
            "reference": true,
            "t0": null,
            "t1": null,
            "voice_sync_text": null,
            "example_calc": {
              "title": "X Ltd (TI: ₹ 1,01,00,000)",
              "inputs": "Domestic Co | Turnover > ₹ 400Cr | TI ₹ 1.01 Cr",
              "steps": [
                "1. Tax @ 30% on ₹ 1,01,00,000 = ₹ 30,30,000",
                "2. Add Surcharge @ 7% = ₹ 2,12,100",
                "3. Total (Tax + Surcharge) = ₹ 32,42,100",
                "4. Ceiling: Tax on ₹ 1Cr (₹ 30L) + Excess Income (₹ 1L) = ₹ 31,00,000",
                "5. Marginal Relief: ₹ 32,42,100 - ₹ 31,00,000 = ₹ 1,42,100",
                "6. Net Tax before Cess = ₹ 31,00,000"
              ]
            }
          }
        ],
