  "q1": {
    "topic_id": "q1",
    "section_code": "Section 4, Section 28",
    "doctrine": "Diversion of Income by Overriding Title vs. Application of Income",
    "total_duration": 80.8,
    "audio_file": "q1.mp3",
    "review_flag": true,
    "root": {
      "id": "root",
      "title": "Diversion vs Application of Income",
      "badge": "§ 4 & 28",
      "summary": "Determination of taxability based on whether income is diverted at source by an overriding title or applied after reaching the assessee.",
      "t0": 0.0,
      "t1": 5.0
    },
    "branches": [
      {
        "branch_id": "b1_overview",
        "branch_title": "Statutory Basis & Concept Overview",
        "badge": "§ Section 4",
        "icon": "shield",
        "t0": 0.0,
        "t1": 17.71,
        "points": [
          {
            "id": "p_b1_1",
            "type": "rule",
            "icon": "shield",
            "title": "Chargeability under Section 4",
            "body": "Income tax is charged on the total income accruing or received by the assessee. If an overriding title diverts income before it reaches the assessee, it cannot be included in total income.",
            "highlights": [
              "Section 4",
              "total income",
              "overriding title"
            ],
            "table_data": null,
            "example_calc": null,
            "trap_data": null,
            "spoken": true,
            "reference": false,
            "t0": 0.0,
            "t1": 6.6,
            "voice_sync_text": "സെക്ഷൻ നാലു പ്രകാരം അസസിക്ക് ലഭിക്കുന്ന ടോട്ടൽ ഇൻകമിന് മേലാണ് നികുതി ചുമത്തുന്നത്."
          },
          {
            "id": "p_b1_2",
            "type": "condition",
            "icon": "scales",
            "title": "Anterior Legal Obligation Test",
            "body": "To constitute diversion by overriding title, there must be an anterior legal obligation that diverts the income at source before it becomes the property of the assessee.",
            "highlights": [
              "anterior legal obligation",
              "diverts at source",
              "Not taxable"
            ],
            "table_data": null,
            "example_calc": null,
            "trap_data": null,
            "spoken": true,
            "reference": false,
            "t0": 6.6,
            "t1": 14.17,
            "voice_sync_text": "എന്നാൽ വരുമാനം അസസിയുടെ കൈകളിൽ എത്തുന്നതിനു മുമ്പ് തന്നെ നിയമപരമായ ഒരു ഓവർറൈഡിംഗ് ടൈറ്റിൽ കാരണം മാറ്റിവെക്കപ്പെട്ടാൽ അത് അസസിയുടെ വരുമാനമായി കണക്കാക്കില്ല."
          }
        ],
        "flow_summary": [
          {
